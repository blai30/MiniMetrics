<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="MiniMetrics.Views.PawnIoPromptWindow"
    Width="400"
    SizeToContent="Height"
    Title="Driver required"
    Icon="avares://MiniMetrics/Assets/minimetrics.ico"
    CanResize="False"
    WindowStartupLocation="CenterScreen"
    Background="Transparent"
    TransparencyLevelHint="Mica"
    TransparencyBackgroundFallback="{DynamicResource Chrome.Surface}">

    <StackPanel Margin="24,22" Spacing="16">
        <TextBlock
            FontSize="20"
            FontWeight="SemiBold"
            TextWrapping="Wrap"
            Text="CPU temperature and power need a driver" />

        <TextBlock
            LineHeight="20"
            TextWrapping="Wrap"
            Text="MiniMetrics reads CPU temperature and power through the PawnIO kernel driver, which is not installed on this machine. Until it is, those two metrics stay blank. Installing PawnIO is a one-time step; afterwards the app asks for elevation only when it needs to read the sensors." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Not now" Click="OnClose" />
            <Button Content="Install PawnIO" IsDefault="True" Classes="accent" Click="OnInstall" />
        </StackPanel>
    </StackPanel>
</Window>
