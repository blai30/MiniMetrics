<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiniMetrics.ViewModels"
        xmlns:conv="using:MiniMetrics.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MiniMetrics.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MiniMetrics"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        CanResize="False"
        Width="400"
        Height="176"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter">

    <Window.Resources>
        <conv:RowColorToBrushConverter x:Key="RowColorToBrush" />
        <conv:TempLevelToBrushConverter x:Key="TempLevelToBrush" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />

        <!-- A compute metric (CPU, GPU): temperature is the hero number, usage is the strong
        second, and an optional power draw sits at the top right. -->
        <DataTemplate x:Key="ComputeTemplate" x:DataType="vm:MetricRowViewModel">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,7">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#C2C9D4"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Detail}"
                               Opacity="{Binding PowerVisible, Converter={StaticResource BoolToOpacity}}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#BCC3CE"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <!-- Temperature hero: big value with a small, top-aligned unit whose degree
                    sign is superscripted. -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Opacity="{Binding TempVisible, Converter={StaticResource BoolToOpacity}}">
                        <TextBlock Text="{Binding Temp}"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   VerticalAlignment="Bottom"
                                   Foreground="{Binding TempLevel, Converter={StaticResource TempLevelToBrush}}" />
                        <TextBlock VerticalAlignment="Top"
                                   Margin="2,8,0,0"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding TempLevel, Converter={StaticResource TempLevelToBrush}}"><Run Text="°" FontSize="13" BaselineAlignment="Superscript" /><Run Text="C" /></TextBlock>
                    </StackPanel>

                    <!-- Usage: strong but secondary; sits on the temperature's baseline. -->
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,4"
                               Opacity="{Binding UsageVisible, Converter={StaticResource BoolToOpacity}}"
                               Foreground="#EEF0F3"><Run Text="{Binding Value}" FontSize="24" FontWeight="Bold" /><Run Text=" " FontSize="8" /><Run Text="%" FontSize="14" FontWeight="SemiBold" /></TextBlock>
                </Grid>

                <ProgressBar Classes="metric"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding BarPercent}"
                             Opacity="{Binding UsageVisible, Converter={StaticResource BoolToOpacity}}"
                             Foreground="{Binding Color, Converter={StaticResource RowColorToBrush}}" />
            </StackPanel>
        </DataTemplate>

        <!-- A memory metric (RAM, VRAM): a quiet used / total readout above its bar. -->
        <DataTemplate x:Key="MemoryTemplate" x:DataType="vm:MetricRowViewModel">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#AEB6C2"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"><Run Text="{Binding Value}" FontSize="16" FontWeight="Bold" Foreground="#EEF0F3" /><Run Text=" " /><Run Text="{Binding Detail}" FontSize="13" FontWeight="SemiBold" Foreground="#AEB6C2" /></TextBlock>
                </Grid>

                <ProgressBar Classes="metric"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding BarPercent}"
                             Foreground="{Binding Color, Converter={StaticResource RowColorToBrush}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ProgressBar.metric">
            <Setter Property="MinHeight" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#40FFFFFF" />
        </Style>
        <Style Selector="ProgressBar.metric /template/ Border#PART_Indicator">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </Window.Styles>

    <Border BorderBrush="#1FFFFFFF"
            BorderThickness="1"
            CornerRadius="0"
            Background="{Binding CardBackground}"
            TextElement.FontFeatures="+tnum">
        <Grid ColumnDefinitions="*,Auto,*">
            <!-- Left column: CPU over RAM. -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto" Margin="20,14,20,16">
                <ContentControl Grid.Row="0"
                                Content="{Binding Cpu}"
                                ContentTemplate="{StaticResource ComputeTemplate}"
                                IsVisible="{Binding Cpu.IsVisible, FallbackValue=False}"
                                VerticalContentAlignment="Center" />
                <ContentControl Grid.Row="1"
                                Margin="0,14,0,0"
                                Content="{Binding Ram}"
                                ContentTemplate="{StaticResource MemoryTemplate}"
                                IsVisible="{Binding Ram.IsVisible, FallbackValue=False}" />
            </Grid>

            <!-- Divider and right column collapse together when there is no GPU. -->
            <Border Grid.Column="1"
                    Width="1"
                    Background="#14FFFFFF"
                    IsVisible="{Binding HasGpu}" />

            <!-- Right column: GPU over VRAM. -->
            <Grid Grid.Column="2"
                  RowDefinitions="*,Auto"
                  Margin="20,14,20,16"
                  IsVisible="{Binding HasGpu}">
                <ContentControl Grid.Row="0"
                                Content="{Binding Gpu}"
                                ContentTemplate="{StaticResource ComputeTemplate}"
                                IsVisible="{Binding Gpu.IsVisible, FallbackValue=False}"
                                VerticalContentAlignment="Center" />
                <ContentControl Grid.Row="1"
                                Margin="0,14,0,0"
                                Content="{Binding Vram}"
                                ContentTemplate="{StaticResource MemoryTemplate}"
                                IsVisible="{Binding Vram.IsVisible, FallbackValue=False}" />
            </Grid>
        </Grid>
    </Border>
</Window>
