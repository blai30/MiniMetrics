<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopMetrics.ViewModels"
        xmlns:conv="using:DesktopMetrics.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="DesktopMetrics.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DesktopMetrics"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        CanResize="False"
        SizeToContent="Height"
        Width="296"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter">

    <Window.Resources>
        <conv:RowColorToBrushConverter x:Key="RowColorToBrush" />
        <conv:TempLevelToBrushConverter x:Key="TempLevelToBrush" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ProgressBar.metric">
            <Setter Property="MinHeight" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="#1FFFFFFF" />
        </Style>
        <Style Selector="ProgressBar.metric /template/ Border#PART_Indicator">
            <Setter Property="CornerRadius" Value="2" />
        </Style>
    </Window.Styles>

    <Border BorderBrush="#1FFFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22,16,22,18"
            TextElement.FontFeatures="+tnum">
        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#F6141926" />
                <GradientStop Offset="1" Color="#F60B0D14" />
            </LinearGradientBrush>
        </Border.Background>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MetricRowViewModel">
                            <StackPanel IsVisible="{Binding IsVisible}">
                                <!-- Columns: label (flex) | value (aligned) | trailing (temp + detail, right). -->
                                <Grid ColumnDefinitions="*,56,110" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#EDEFF2"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               TextAlignment="Right"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Temp}"
                                                   Width="40"
                                                   TextAlignment="Right"
                                                   IsVisible="{Binding HasTemp}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding TempLevel, Converter={StaticResource TempLevelToBrush}}" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Width="62"
                                                   TextAlignment="Right"
                                                   IsVisible="{Binding HasDetail}"
                                                   FontSize="15"
                                                   FontWeight="Medium"
                                                   Foreground="#9AA1AC" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Classes="metric"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BarPercent}"
                                             Foreground="{Binding Color, Converter={StaticResource RowColorToBrush}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
    </Border>
</Window>
