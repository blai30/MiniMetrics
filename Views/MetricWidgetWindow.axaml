<views:OverlayWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:vm="using:MiniMetrics.ViewModels"
                     xmlns:conv="using:MiniMetrics.Converters"
                     xmlns:views="using:MiniMetrics.Views"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     mc:Ignorable="d"
                     x:Class="MiniMetrics.Views.MetricWidgetWindow"
                     x:DataType="vm:MetricWidgetViewModel"
                     Title="MiniMetrics"
                     WindowDecorations="None"
                     Background="Transparent"
                     TransparencyLevelHint="Transparent"
                     ShowInTaskbar="False"
                     Topmost="False"
                     CanResize="False"
                     Width="{Binding ScaledWidth}"
                     Height="{Binding ScaledHeight}"
                     TextOptions.TextRenderingMode="Antialias"
                     FontFamily="{Binding FontFamily}">

    <Window.Resources>
        <conv:RowColorToBrushConverter x:Key="RowColorToBrush" />
        <conv:TempLevelToBrushConverter x:Key="TempLevelToBrush" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <conv:ScaleConverter x:Key="Scale" />
        <conv:ThicknessScaleConverter x:Key="ThicknessScale" />

        <!-- A compute metric (CPU, GPU): temperature is the hero number, usage is the strong
        second, and an optional power draw sits at the top right. -->
        <DataTemplate x:Key="ComputeTemplate" x:DataType="vm:MetricRowViewModel">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto"
                      Margin="{Binding Scale, Converter={StaticResource ThicknessScale}, ConverterParameter='0,0,0,7'}">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=18}"
                               FontWeight="{Binding StrongWeight}"
                               Foreground="{DynamicResource Widget.Text.Label}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Detail}"
                               Opacity="{Binding PowerVisible, Converter={StaticResource BoolToOpacity}}"
                               FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=18}"
                               FontWeight="{Binding StrongWeight}"
                               Foreground="{DynamicResource Widget.Text.Secondary}"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="{Binding Scale, Converter={StaticResource ThicknessScale}, ConverterParameter='0,0,0,2'}">
                    <!-- Temperature hero: big value with a small, top-aligned unit whose degree
                    sign is superscripted. -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Opacity="{Binding TempVisible, Converter={StaticResource BoolToOpacity}}">
                        <TextBlock Text="{Binding Temp}"
                                   FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=42}"
                                   FontWeight="{Binding StrongWeight}"
                                   VerticalAlignment="Bottom"
                                   Foreground="{Binding TempLevel, Converter={StaticResource TempLevelToBrush}}" />
                        <TextBlock VerticalAlignment="Top"
                                   Margin="{Binding Scale, Converter={StaticResource ThicknessScale}, ConverterParameter='2,8,0,0'}"
                                   FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=19}"
                                   FontWeight="{Binding UnitWeight}"
                                   Foreground="{Binding TempLevel, Converter={StaticResource TempLevelToBrush}}">
                            <Run Text="°"
                                 FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=13}"
                                 BaselineAlignment="Superscript" />
                            <Run Text="C" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Usage: strong but secondary; sits on the temperature's baseline. -->
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Bottom"
                               Margin="{Binding Scale, Converter={StaticResource ThicknessScale}, ConverterParameter='0,0,0,4'}"
                               Opacity="{Binding UsageVisible, Converter={StaticResource BoolToOpacity}}"
                               Foreground="{DynamicResource Widget.Text.Primary}">
                        <Run Text="{Binding Value}"
                             FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=24}"
                             FontWeight="{Binding StrongWeight}" />
                        <Run Text=" "
                             FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=8}" />
                        <Run Text="%"
                             FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=14}"
                             FontWeight="{Binding UnitWeight}" />
                    </TextBlock>
                </Grid>

                <ProgressBar Classes="metric"
                             Minimum="0"
                             Maximum="100"
                             Height="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=5}"
                             MinHeight="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=5}"
                             Value="{Binding BarPercent}"
                             Opacity="{Binding UsageVisible, Converter={StaticResource BoolToOpacity}}"
                             Foreground="{Binding Color, Converter={StaticResource RowColorToBrush}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Compact compute (CPU, GPU): label, then temperature / usage / power inline. No bars,
        neutral text except the temperature heat color. Numeric slots are fixed width so the row only
        changes width when a metric is toggled, not when a value's digit count changes. -->
        <DataTemplate x:Key="ComputeCompactTemplate" x:DataType="vm:MetricRowViewModel">
            <StackPanel Orientation="Horizontal"
                        Spacing="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=12}"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}"
                           FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=22}"
                           FontWeight="{Binding StrongWeight}"
                           Foreground="{DynamicResource Widget.Text.Label}"
                           VerticalAlignment="Center" />
                <TextBlock IsVisible="{Binding TempVisible}"
                           VerticalAlignment="Center"
                           MinWidth="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=72}"
                           TextAlignment="Right"
                           Foreground="{Binding TempLevel, Converter={StaticResource TempLevelToBrush}}">
                    <Run Text="{Binding Temp}"
                         FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=26}"
                         FontWeight="{Binding StrongWeight}" />
                    <Run Text="°C" FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=16}"
                         FontWeight="{Binding UnitWeight}" />
                </TextBlock>
                <TextBlock IsVisible="{Binding UsageVisible}"
                           VerticalAlignment="Center"
                           MinWidth="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=64}"
                           TextAlignment="Right"
                           Foreground="{DynamicResource Widget.Text.Primary}">
                    <Run Text="{Binding Value}"
                         FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=26}"
                         FontWeight="{Binding StrongWeight}" />
                    <Run Text="%" FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=16}"
                         FontWeight="{Binding UnitWeight}" />
                </TextBlock>
                <TextBlock IsVisible="{Binding PowerVisible}"
                           Text="{Binding Detail}"
                           VerticalAlignment="Center"
                           MinWidth="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=66}"
                           TextAlignment="Right"
                           FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=22}"
                           FontWeight="{Binding StrongWeight}"
                           Foreground="{DynamicResource Widget.Text.Secondary}" />
            </StackPanel>
        </DataTemplate>

        <!-- Compact memory (RAM, VRAM): label then used / total inline. -->
        <DataTemplate x:Key="MemoryCompactTemplate" x:DataType="vm:MetricRowViewModel">
            <StackPanel Orientation="Horizontal"
                        Spacing="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=10}"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}"
                           FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=22}"
                           FontWeight="{Binding StrongWeight}"
                           Foreground="{DynamicResource Widget.Text.Label}"
                           VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding Value}"
                         FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=26}"
                         FontWeight="{Binding StrongWeight}"
                         Foreground="{DynamicResource Widget.Text.Primary}" />
                    <Run Text=" " />
                    <Run Text="{Binding Detail}"
                         FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=17}"
                         FontWeight="{Binding UnitWeight}"
                         Foreground="{DynamicResource Widget.Text.Secondary}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- A memory metric (RAM, VRAM): a quiet used / total readout above its bar. -->
        <DataTemplate x:Key="MemoryTemplate" x:DataType="vm:MetricRowViewModel">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto"
                      Margin="{Binding Scale, Converter={StaticResource ThicknessScale}, ConverterParameter='0,0,0,6'}">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=16}"
                               FontWeight="{Binding StrongWeight}"
                               Foreground="{DynamicResource Widget.Text.Label}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center">
                        <Run Text="{Binding Value}"
                             FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=16}"
                             FontWeight="{Binding StrongWeight}"
                             Foreground="{DynamicResource Widget.Text.Primary}" />
                        <Run Text=" " />
                        <Run Text="{Binding Detail}"
                             FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=13}"
                             FontWeight="{Binding UnitWeight}"
                             Foreground="{DynamicResource Widget.Text.Secondary}" />
                    </TextBlock>
                </Grid>

                <ProgressBar Classes="metric"
                             Minimum="0"
                             Maximum="100"
                             Height="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=5}"
                             MinHeight="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=5}"
                             Value="{Binding BarPercent}"
                             Foreground="{Binding Color, Converter={StaticResource RowColorToBrush}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ProgressBar.metric">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Widget.Bar.Track}" />
        </Style>
        <Style Selector="ProgressBar.metric /template/ Border#PART_Indicator">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </Window.Styles>

    <Border BorderThickness="0"
            CornerRadius="0"
            Background="{Binding CardBackground}"
            TextElement.FontFeatures="+tnum">
        <Panel>
            <!-- Full layout: compute card stacked over memory card. -->
            <Grid RowDefinitions="*,Auto"
                  Margin="{Binding Scale, Converter={StaticResource ThicknessScale}, ConverterParameter='20,14,20,16'}"
                  IsVisible="{Binding !IsCompact}">
                <ContentControl Grid.Row="0"
                                Content="{Binding Compute}"
                                ContentTemplate="{StaticResource ComputeTemplate}"
                                IsVisible="{Binding Compute.IsVisible, FallbackValue=False}"
                                VerticalContentAlignment="Center" />
                <ContentControl Grid.Row="1"
                                Margin="{Binding Scale, Converter={StaticResource ThicknessScale}, ConverterParameter='0,14,0,0'}"
                                Content="{Binding Memory}"
                                ContentTemplate="{StaticResource MemoryTemplate}"
                                IsVisible="{Binding Memory.IsVisible, FallbackValue=False}" />
            </Grid>

            <!-- Compact layout: everything on one line, no bars. -->
            <StackPanel Orientation="Horizontal"
                        Margin="{Binding Scale, Converter={StaticResource ThicknessScale}, ConverterParameter='18,0'}"
                        Spacing="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=18}"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsCompact}">
                <ContentControl Content="{Binding Compute}"
                                ContentTemplate="{StaticResource ComputeCompactTemplate}"
                                IsVisible="{Binding Compute.IsVisible, FallbackValue=False}" />
                <ContentControl Content="{Binding Memory}"
                                ContentTemplate="{StaticResource MemoryCompactTemplate}"
                                IsVisible="{Binding Memory.IsVisible, FallbackValue=False}" />
            </StackPanel>
        </Panel>
    </Border>
</views:OverlayWindow>
