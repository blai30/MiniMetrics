<views:OverlayWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiniMetrics.ViewModels"
        xmlns:conv="using:MiniMetrics.Converters"
        xmlns:views="using:MiniMetrics.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MiniMetrics.Views.MetricWidgetWindow"
        x:DataType="vm:MetricWidgetViewModel"
        Title="MiniMetrics"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        CanResize="False"
        Width="210"
        Height="176"
        TextOptions.TextRenderingMode="Antialias"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter">

    <Window.Resources>
        <conv:RowColorToBrushConverter x:Key="RowColorToBrush" />
        <conv:TempLevelToBrushConverter x:Key="TempLevelToBrush" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />

        <!-- A compute metric (CPU, GPU): temperature is the hero number, usage is the strong
        second, and an optional power draw sits at the top right. -->
        <DataTemplate x:Key="ComputeTemplate" x:DataType="vm:MetricRowViewModel">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,7">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Widget.Text.Label}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Detail}"
                               Opacity="{Binding PowerVisible, Converter={StaticResource BoolToOpacity}}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Widget.Text.Secondary}"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                    <!-- Temperature hero: big value with a small, top-aligned unit whose degree
                    sign is superscripted. -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Opacity="{Binding TempVisible, Converter={StaticResource BoolToOpacity}}">
                        <TextBlock Text="{Binding Temp}"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   VerticalAlignment="Bottom"
                                   Foreground="{Binding TempLevel, Converter={StaticResource TempLevelToBrush}}" />
                        <TextBlock VerticalAlignment="Top"
                                   Margin="2,8,0,0"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding TempLevel, Converter={StaticResource TempLevelToBrush}}"><Run Text="°" FontSize="13" BaselineAlignment="Superscript" /><Run Text="C" /></TextBlock>
                    </StackPanel>

                    <!-- Usage: strong but secondary; sits on the temperature's baseline. -->
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,4"
                               Opacity="{Binding UsageVisible, Converter={StaticResource BoolToOpacity}}"
                               Foreground="{DynamicResource Widget.Text.Primary}"><Run Text="{Binding Value}" FontSize="24" FontWeight="Bold" /><Run Text=" " FontSize="8" /><Run Text="%" FontSize="14" FontWeight="SemiBold" /></TextBlock>
                </Grid>

                <ProgressBar Classes="metric"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding BarPercent}"
                             Opacity="{Binding UsageVisible, Converter={StaticResource BoolToOpacity}}"
                             Foreground="{Binding Color, Converter={StaticResource RowColorToBrush}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Compact compute (CPU, GPU): label, then temperature / usage / power inline. No bars,
        neutral text except the temperature heat color. Numeric slots are fixed width so the row only
        changes width when a metric is toggled, not when a value's digit count changes. -->
        <DataTemplate x:Key="ComputeCompactTemplate" x:DataType="vm:MetricRowViewModel">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Widget.Text.Label}"
                           VerticalAlignment="Center" />
                <TextBlock IsVisible="{Binding TempVisible}"
                           VerticalAlignment="Center"
                           MinWidth="72"
                           TextAlignment="Right"
                           Foreground="{Binding TempLevel, Converter={StaticResource TempLevelToBrush}}"><Run Text="{Binding Temp}" FontSize="26" FontWeight="Bold" /><Run Text="°C" FontSize="16" FontWeight="SemiBold" /></TextBlock>
                <TextBlock IsVisible="{Binding UsageVisible}"
                           VerticalAlignment="Center"
                           MinWidth="64"
                           TextAlignment="Right"
                           Foreground="{DynamicResource Widget.Text.Primary}"><Run Text="{Binding Value}" FontSize="26" FontWeight="Bold" /><Run Text="%" FontSize="16" FontWeight="SemiBold" /></TextBlock>
                <TextBlock IsVisible="{Binding PowerVisible}"
                           Text="{Binding Detail}"
                           VerticalAlignment="Center"
                           MinWidth="66"
                           TextAlignment="Right"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Widget.Text.Secondary}" />
            </StackPanel>
        </DataTemplate>

        <!-- Compact memory (RAM, VRAM): label then used / total inline. -->
        <DataTemplate x:Key="MemoryCompactTemplate" x:DataType="vm:MetricRowViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Widget.Text.Label}"
                           VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center"><Run Text="{Binding Value}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Widget.Text.Primary}" /><Run Text=" " /><Run Text="{Binding Detail}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Widget.Text.Secondary}" /></TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- A memory metric (RAM, VRAM): a quiet used / total readout above its bar. -->
        <DataTemplate x:Key="MemoryTemplate" x:DataType="vm:MetricRowViewModel">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Widget.Text.Label}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"><Run Text="{Binding Value}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Widget.Text.Primary}" /><Run Text=" " /><Run Text="{Binding Detail}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Widget.Text.Secondary}" /></TextBlock>
                </Grid>

                <ProgressBar Classes="metric"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding BarPercent}"
                             Foreground="{Binding Color, Converter={StaticResource RowColorToBrush}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ProgressBar.metric">
            <Setter Property="MinHeight" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Widget.Bar.Track}" />
        </Style>
        <Style Selector="ProgressBar.metric /template/ Border#PART_Indicator">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </Window.Styles>

    <Border BorderThickness="0"
            CornerRadius="0"
            Background="{Binding CardBackground}"
            TextElement.FontFeatures="+tnum">
        <Panel>
            <!-- Full layout: compute card stacked over memory card. -->
            <Grid RowDefinitions="*,Auto" Margin="20,14,20,16" IsVisible="{Binding !IsCompact}">
                <ContentControl Grid.Row="0"
                                Content="{Binding Compute}"
                                ContentTemplate="{StaticResource ComputeTemplate}"
                                IsVisible="{Binding Compute.IsVisible, FallbackValue=False}"
                                VerticalContentAlignment="Center" />
                <ContentControl Grid.Row="1"
                                Margin="0,14,0,0"
                                Content="{Binding Memory}"
                                ContentTemplate="{StaticResource MemoryTemplate}"
                                IsVisible="{Binding Memory.IsVisible, FallbackValue=False}" />
            </Grid>

            <!-- Compact layout: everything on one line, no bars. -->
            <StackPanel Orientation="Horizontal"
                        Margin="18,0"
                        Spacing="18"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsCompact}">
                <ContentControl Content="{Binding Compute}"
                                ContentTemplate="{StaticResource ComputeCompactTemplate}"
                                IsVisible="{Binding Compute.IsVisible, FallbackValue=False}" />
                <ContentControl Content="{Binding Memory}"
                                ContentTemplate="{StaticResource MemoryCompactTemplate}"
                                IsVisible="{Binding Memory.IsVisible, FallbackValue=False}" />
            </StackPanel>
        </Panel>
    </Border>
</views:OverlayWindow>
