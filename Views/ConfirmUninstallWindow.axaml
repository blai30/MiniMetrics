<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MiniMetrics.Views.ConfirmUninstallWindow"
        Title="Uninstall MiniMetrics"
        Icon="avares://MiniMetrics/Assets/minimetrics.ico"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="22" Spacing="14">

        <TextBlock Text="Uninstall MiniMetrics?"
                   FontSize="15"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBlock TextWrapping="Wrap"
                   LineHeight="20"
                   Text="This removes MiniMetrics and its startup entries. If CPU temperature or power was enabled, you will see one UAC prompt to remove the elevated startup task; declining it cancels the uninstall." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
            <Button Content="Uninstall" Click="OnConfirm" Classes="accent" />
        </StackPanel>

    </StackPanel>
</Window>