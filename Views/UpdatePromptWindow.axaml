<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiniMetrics.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MiniMetrics.Views.UpdatePromptWindow"
        x:DataType="vm:UpdatePromptViewModel"
        Title="MiniMetrics update"
        Icon="avares://MiniMetrics/Assets/minimetrics.ico"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="22" Spacing="14">

        <TextBlock Text="{Binding Heading}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBlock Text="{Binding Body}"
                   TextWrapping="Wrap"
                   LineHeight="20" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0"
                    IsVisible="{Binding IsActionable}">
            <Button Content="Remind me later" Click="OnDismiss" />
            <Button Content="Skip this version" Click="OnSkip" />
            <Button Content="View release" Click="OnViewRelease" Classes="accent"
                    IsVisible="{Binding !CanInstall}" />
            <Button Content="Install and restart" Click="OnInstall" Classes="accent"
                    IsVisible="{Binding CanInstall}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0"
                    IsVisible="{Binding IsInformational}">
            <Button Content="Close"
                    Click="OnClose"
                    IsDefault="True"
                    IsCancel="True"
                    Classes="accent" />
        </StackPanel>

    </StackPanel>
</Window>
