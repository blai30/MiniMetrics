<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MiniMetrics.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="using:MiniMetrics.Views"
    mc:Ignorable="d"
    x:Class="MiniMetrics.Views.UpdatePromptWindow"
    x:DataType="vm:UpdatePromptViewModel"
    Width="480"
    SizeToContent="Height"
    TransparencyLevelHint="Mica"
    Background="Transparent"
    Title="MiniMetrics update"
    Icon="avares://MiniMetrics/Assets/minimetrics.ico"
    CanResize="False"
    WindowStartupLocation="CenterScreen">

    <StackPanel Margin="24,22" Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="14">
            <Border
                Width="44"
                Height="44"
                VerticalAlignment="Top"
                CornerRadius="10"
                Background="{DynamicResource AccentFillColorDefaultBrush}">
                <v:LucideIcon
                    Width="20"
                    Height="20"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    Symbol="download" />
            </Border>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="17"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                Text="{Binding Heading}" />
        </StackPanel>

        <TextBlock TextWrapping="Wrap" LineHeight="20" Text="{Binding Body}" />

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8"
            IsVisible="{Binding IsActionable}">
            <Button Content="Remind me later" Click="OnDismiss" />
            <Button Content="Skip this version" Click="OnSkip" />
            <Button
                Content="View release"
                Classes="accent"
                IsVisible="{Binding !CanInstall}"
                Click="OnViewRelease" />
            <Button
                Content="Install and restart"
                Classes="accent"
                IsVisible="{Binding CanInstall}"
                Click="OnInstall" />
        </StackPanel>

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8"
            IsVisible="{Binding IsInformational}">
            <Button
                Content="Close"
                IsDefault="True"
                IsCancel="True"
                Classes="accent"
                Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
