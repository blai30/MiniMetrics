<views:OverlayWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MiniMetrics.ViewModels"
    xmlns:conv="using:MiniMetrics.Converters"
    xmlns:views="using:MiniMetrics.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="MiniMetrics.Views.DateTimeWindow"
    x:DataType="vm:DateTimeWidgetViewModel"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    TextOptions.TextRenderingMode="Antialias"
    FontFamily="{Binding FontFamily}"
    Title="MiniMetrics Clock"
    WindowDecorations="None"
    ShowInTaskbar="False"
    Topmost="False"
    CanResize="False">

    <Window.Resources>
        <conv:ScaleConverter x:Key="Scale" />
        <conv:ThicknessScaleConverter x:Key="ThicknessScale" />

        <!-- Every line is a StableWidthTextBlock: the digits draw with the font's own proportional widths,
        but each line reserves the width of its digit shape as tabular figures, so a tick that only
        changes which digits are showing never resizes the window. -->

        <!-- Full layout: time over date. -->
        <DataTemplate x:Key="FullLayout" x:DataType="vm:DateTimeWidgetViewModel">
            <StackPanel
                VerticalAlignment="Center"
                Margin="{Binding Scale, Converter={StaticResource ThicknessScale}, ConverterParameter='28,0,28,0'}">
                <views:StableWidthTextBlock
                    FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=80}"
                    FontWeight="{Binding ClockWeight}"
                    TextAlignment="{Binding TextAlignment}"
                    Foreground="{DynamicResource Widget.Text.Primary}"
                    Text="{Binding TimeText}" />
                <views:StableWidthTextBlock
                    FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=28}"
                    FontWeight="{Binding ClockWeight}"
                    TextAlignment="{Binding TextAlignment}"
                    Foreground="{DynamicResource Widget.Text.Label}"
                    Text="{Binding DateText}" />
            </StackPanel>
        </DataTemplate>

        <!-- Compact layout: time and date on one line. The two lines pin their text to facing
        edges so the reserved slack lands on the outside of the row and the gap between them
        stays constant. -->
        <DataTemplate x:Key="CompactLayout" x:DataType="vm:DateTimeWidgetViewModel">
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="{Binding BlockAlignment}"
                Margin="{Binding Scale, Converter={StaticResource ThicknessScale}, ConverterParameter='20,0'}"
                Spacing="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=16}">
                <views:StableWidthTextBlock
                    VerticalAlignment="Center"
                    TextAlignment="Right"
                    FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=26}"
                    FontWeight="{Binding ClockWeight}"
                    Foreground="{DynamicResource Widget.Text.Primary}"
                    Text="{Binding TimeText}" />
                <views:StableWidthTextBlock
                    VerticalAlignment="Center"
                    TextAlignment="Left"
                    FontSize="{Binding Scale, Converter={StaticResource Scale}, ConverterParameter=26}"
                    FontWeight="{Binding ClockWeight}"
                    Foreground="{DynamicResource Widget.Text.Label}"
                    Text="{Binding DateText}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Only the active layout is realized, so the hidden one neither holds controls nor re-shapes its
        text on every tick. -->
        <Style Selector="ContentControl#Layout">
            <Setter Property="ContentTemplate" Value="{StaticResource FullLayout}" />
        </Style>
        <Style Selector="ContentControl#Layout.compact">
            <Setter Property="ContentTemplate" Value="{StaticResource CompactLayout}" />
        </Style>
    </Window.Styles>

    <Border BorderThickness="0" CornerRadius="0" Background="{Binding CardBackground}">
        <ContentControl
            Name="Layout"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Content="{Binding}"
            Classes.compact="{Binding IsCompact}" />
    </Border>
</views:OverlayWindow>
