<views:OverlayWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:vm="using:MiniMetrics.ViewModels"
                     xmlns:views="using:MiniMetrics.Views"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     mc:Ignorable="d"
                     x:Class="MiniMetrics.Views.DateTimeWindow"
                     x:DataType="vm:DateTimeWidgetViewModel"
                     Title="MiniMetrics Clock"
                     WindowDecorations="None"
                     Background="Transparent"
                     TransparencyLevelHint="Transparent"
                     ShowInTaskbar="False"
                     Topmost="False"
                     CanResize="False"
                     Width="640"
                     Height="176"
                     TextOptions.TextRenderingMode="Antialias"
                     FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter">

    <Border BorderThickness="0"
            CornerRadius="0"
            Background="{Binding CardBackground}">
        <Panel>
            <!-- Full layout: time over date. -->
            <StackPanel VerticalAlignment="Center" Margin="28,0,28,0" IsVisible="{Binding !IsCompact}">
                <TextBlock Text="{Binding TimeText}"
                           FontSize="80"
                           FontWeight="Medium"
                           TextAlignment="{Binding TextAlignment}"
                           Foreground="{DynamicResource Widget.Text.Primary}" />
                <TextBlock Text="{Binding DateText}"
                           FontSize="28"
                           FontWeight="Medium"
                           TextAlignment="{Binding TextAlignment}"
                           Foreground="{DynamicResource Widget.Text.Label}" />
            </StackPanel>

            <!-- Compact layout: time and date on one line. -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="{Binding BlockAlignment}"
                        Margin="20,0"
                        Spacing="16"
                        IsVisible="{Binding IsCompact}">
                <TextBlock Text="{Binding TimeText}"
                           FontSize="46"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Widget.Text.Primary}" />
                <TextBlock Text="{Binding DateText}"
                           FontSize="28"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Widget.Text.Label}" />
            </StackPanel>
        </Panel>
    </Border>
</views:OverlayWindow>