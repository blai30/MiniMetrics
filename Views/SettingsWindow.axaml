<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:MiniMetrics.ViewModels"
    xmlns:conv="using:MiniMetrics.Converters"
    xmlns:models="using:MiniMetrics.Models"
    xmlns:sys="using:System"
    xmlns:glob="using:System.Globalization"
    xmlns:v="using:MiniMetrics.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="MiniMetrics.Views.SettingsWindow"
    x:DataType="vm:SettingsViewModel"
    Width="1000"
    Height="720"
    MinWidth="540"
    MinHeight="440"
    FontSize="16"
    TransparencyLevelHint="Mica"
    Background="Transparent"
    Title="Mini Metrics Settings"
    Icon="avares://MiniMetrics/Assets/minimetrics.ico"
    CanResize="True"
    WindowStartupLocation="CenterScreen"
    PointerPressed="OnSettingsPointerPressed">

    <Window.Resources>
        <conv:UpdateFrequencyLabelConverter x:Key="FrequencyLabel" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:StringToFontFamilyConverter x:Key="StringToFontFamily" />
        <conv:LucideIconSourceConverter x:Key="LucideIconSource" />
    </Window.Resources>

    <Window.Styles>
        <!-- A non-expandable setting card (no items) still toggles IsExpanded when its empty space is
        clicked; FluentAvalonia resets it, but in between the expanded content border is laid out and the
        card grows ~1px. Zeroing that border on :empty cards makes the stray click have no layout effect. -->
        <Style Selector="ui|FASettingsExpander:empty /template/ Expander#Expander">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- The per-option restore-default button. Transparent, borderless, and only visible while the
        option strays from its default (each instance binds IsVisible to that option's *Modified flag).
        The hover and pressed states recolor the template content presenter with the Fluent subtle fills
        and a rounded corner, since the base Button theme otherwise paints a flat square fill on hover. -->
        <Style Selector="Button.reset">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- The icon inherits this Foreground, so the restore glyph renders in the accent color. -->
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.reset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.reset:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootArea" Focusable="True">
        <ui:FANavigationView
            x:Name="Nav"
            PaneDisplayMode="Left"
            IsSettingsVisible="False"
            IsBackButtonVisible="False"
            OpenPaneLength="200"
            SelectionChanged="OnNavSelectionChanged">
            <ui:FANavigationView.MenuItems>
                <ui:FANavigationViewItem Tag="Appearance" IsSelected="True">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <v:LucideIcon Symbol="palette" Width="16" Height="16" />
                        <TextBlock VerticalAlignment="Center" Text="Appearance" />
                    </StackPanel>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Tag="Clock">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <v:LucideIcon Symbol="clock" Width="16" Height="16" />
                        <TextBlock VerticalAlignment="Center" Text="Clock" />
                    </StackPanel>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Tag="Metrics">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <v:LucideIcon Symbol="gauge" Width="16" Height="16" />
                        <TextBlock VerticalAlignment="Center" Text="Metrics" />
                    </StackPanel>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Tag="Updates">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <v:LucideIcon Symbol="refresh-cw" Width="16" Height="16" />
                        <TextBlock VerticalAlignment="Center" Text="Updates" />
                    </StackPanel>
                </ui:FANavigationViewItem>
            </ui:FANavigationView.MenuItems>

            <ui:FANavigationView.PaneFooter>
                <HyperlinkButton
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Margin="4,0,4,4"
                    Padding="12,8"
                    NavigateUri="https://github.com/blai30/MiniMetrics"
                    ToolTip.Tip="View MiniMetrics on GitHub">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon
                            Width="16"
                            Height="16"
                            Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                        <TextBlock VerticalAlignment="Center" Text="GitHub" />
                    </StackPanel>
                </HyperlinkButton>
            </ui:FANavigationView.PaneFooter>

            <Grid>
                <!-- Appearance page -->
                <ScrollViewer x:Name="AppearancePage" Padding="28,20,28,28" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6" MaxWidth="720">
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="Appearance" />

                        <ui:FASettingsExpander Header="Theme" Description="Color mode for the app and widgets"
                                               IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=sun-moon, x:CompileBindings=False}">
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                            Command="{Binding RestoreThemeCommand}" IsVisible="{Binding ThemeModified}">
                                        <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                    </Button>
                                    <ComboBox
                                        MinWidth="160"
                                        ItemsSource="{Binding Themes}"
                                        SelectedItem="{Binding Theme}" />
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander
                            Header="Background color"
                            Description="Translucent fill behind every widget"
                            IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=palette, x:CompileBindings=False}">
                            <ui:FASettingsExpanderItem>
                                <ItemsControl ItemsSource="{Binding Swatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <Button
                                                Width="34"
                                                Height="34"
                                                Margin="0,0,8,8"
                                                CornerRadius="8"
                                                Background="{Binding}"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectPresetCommand}"
                                                CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="Custom hex">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="reset" ToolTip.Tip="Restore default"
                                                Command="{Binding RestoreBackgroundColorCommand}"
                                                IsVisible="{Binding BackgroundColorModified}">
                                            <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                        </Button>
                                        <TextBox
                                            Width="120"
                                            Text="{Binding BackgroundColor}"
                                            PlaceholderText="#RRGGBB" />
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Opacity" Description="How opaque the widget background is"
                                               IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=blend, x:CompileBindings=False}">
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                            Command="{Binding RestoreOpacityCommand}"
                                            IsVisible="{Binding OpacityModified}">
                                        <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                    </Button>
                                    <Grid ColumnDefinitions="200,Auto">
                                        <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Opacity}" />
                                        <NumericUpDown
                                            Grid.Column="1"
                                            x:Name="OpacityInput"
                                            Width="96"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            TextAlignment="Right"
                                            Minimum="0"
                                            Maximum="100"
                                            Increment="1"
                                            Value="{Binding Opacity, Mode=OneWay}"
                                            ShowButtonSpinner="False"
                                            ClipValueToMinMax="True"
                                            KeyDown="OnPercentInputKeyDown"
                                            LostFocus="OnPercentInputLostFocus">
                                            <NumericUpDown.InnerRightContent>
                                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="%" />
                                            </NumericUpDown.InnerRightContent>
                                        </NumericUpDown>
                                    </Grid>
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Widget size" Description="Scale of every widget on screen"
                                               IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=scaling, x:CompileBindings=False}">
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                            Command="{Binding RestoreWidgetScaleCommand}"
                                            IsVisible="{Binding WidgetScaleModified}">
                                        <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                    </Button>
                                    <Grid ColumnDefinitions="200,Auto">
                                        <Slider Grid.Column="0" Minimum="50" Maximum="200"
                                                Value="{Binding WidgetScale}" />
                                        <NumericUpDown
                                            Grid.Column="1"
                                            x:Name="WidgetScaleInput"
                                            Width="96"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            TextAlignment="Right"
                                            Minimum="50"
                                            Maximum="200"
                                            Increment="1"
                                            Value="{Binding WidgetScale, Mode=OneWay}"
                                            ShowButtonSpinner="False"
                                            ClipValueToMinMax="True"
                                            KeyDown="OnPercentInputKeyDown"
                                            LostFocus="OnPercentInputLostFocus">
                                            <NumericUpDown.InnerRightContent>
                                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="%" />
                                            </NumericUpDown.InnerRightContent>
                                        </NumericUpDown>
                                    </Grid>
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Font" Description="Typeface and weight used by the widgets"
                                               IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=type, x:CompileBindings=False}">
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                            Command="{Binding RestoreWidgetFontFamilyCommand}"
                                            IsVisible="{Binding WidgetFontFamilyModified}">
                                        <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                    </Button>
                                    <Grid Width="200">
                                        <AutoCompleteBox
                                            x:Name="FontBox"
                                            HorizontalAlignment="Stretch"
                                            FontFamily="{Binding WidgetFontFamily, Converter={StaticResource StringToFontFamily}}"
                                            ItemsSource="{Binding AvailableFonts}"
                                            SelectedItem="{Binding WidgetFontFamily}"
                                            FilterMode="Custom"
                                            MinimumPrefixLength="0"
                                            MaxDropDownHeight="280"
                                            PlaceholderText="Search font...">
                                            <AutoCompleteBox.ItemTemplate>
                                                <!-- Each name is drawn in the font it names. TextTrimming keeps a
                                                long name from widening the fixed-width dropdown popup. -->
                                                <DataTemplate x:DataType="sys:String">
                                                    <TextBlock
                                                        MaxWidth="168"
                                                        FontFamily="{Binding Converter={StaticResource StringToFontFamily}}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Text="{Binding}" />
                                                </DataTemplate>
                                            </AutoCompleteBox.ItemTemplate>
                                        </AutoCompleteBox>
                                        <Button
                                            x:Name="FontChevron"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            Padding="9,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False">
                                            <v:LucideIcon Width="11" Height="11" Symbol="chevron-down" />
                                        </Button>
                                    </Grid>
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                            Command="{Binding RestoreWidgetFontWeightCommand}"
                                            IsVisible="{Binding WidgetFontWeightModified}">
                                        <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                    </Button>
                                    <ComboBox
                                        MinWidth="140"
                                        ItemsSource="{Binding WidgetFontWeights}"
                                        SelectedItem="{Binding WidgetFontWeight}" />
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander
                            Header="Compact layout"
                            Description="Use the condensed single-line widget layout"
                            IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=rows-2, x:CompileBindings=False}">
                            <ui:FASettingsExpanderItem Content="CPU widget">
                                <ui:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch IsChecked="{Binding CpuCompact}" OnContent="" OffContent="" />
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="GPU widget">
                                <ui:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch IsChecked="{Binding GpuCompact}" OnContent="" OffContent="" />
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="Clock widget">
                                <ui:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch IsChecked="{Binding DateTimeCompact}" OnContent="" OffContent="" />
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Clock page -->
                <ScrollViewer
                    x:Name="ClockPage"
                    Padding="28,20,28,28"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="False">
                    <StackPanel Spacing="6" MaxWidth="720">
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="Clock" />

                        <ui:FASettingsExpander
                            Header="Use local time"
                            Description="Follow the system clock and time zone"
                            IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=clock, x:CompileBindings=False}">
                            <ui:FASettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding UseLocalTime}" OnContent="" OffContent="" />
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Time zone" IsEnabled="{Binding !UseLocalTime}"
                                               IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=globe, x:CompileBindings=False}">
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                            Command="{Binding RestoreTimeZoneCommand}"
                                            IsVisible="{Binding TimeZoneModified}">
                                        <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                    </Button>
                                    <Grid Width="340">
                                        <AutoCompleteBox
                                            x:Name="TimeZoneBox"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding TimeZones}"
                                            SelectedItem="{Binding SelectedTimeZone}"
                                            FilterMode="Custom"
                                            MinimumPrefixLength="0"
                                            MaxDropDownHeight="280"
                                            PlaceholderText="Search time zone...">
                                            <AutoCompleteBox.ValueMemberBinding>
                                                <ReflectionBinding Path="DisplayName" />
                                            </AutoCompleteBox.ValueMemberBinding>
                                            <AutoCompleteBox.ItemTemplate>
                                                <DataTemplate x:DataType="sys:TimeZoneInfo">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </AutoCompleteBox.ItemTemplate>
                                        </AutoCompleteBox>
                                        <Button
                                            x:Name="TimeZoneChevron"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            Padding="9,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False">
                                            <v:LucideIcon Width="11" Height="11" Symbol="chevron-down" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Locale"
                                               IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=languages, x:CompileBindings=False}">
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                            Command="{Binding RestoreLocaleCommand}"
                                            IsVisible="{Binding LocaleModified}">
                                        <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                    </Button>
                                    <Grid Width="340">
                                        <AutoCompleteBox
                                            x:Name="LocaleBox"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding Locales}"
                                            SelectedItem="{Binding SelectedLocale}"
                                            FilterMode="Custom"
                                            MinimumPrefixLength="0"
                                            MaxDropDownHeight="280"
                                            PlaceholderText="Search locale...">
                                            <AutoCompleteBox.ValueMemberBinding>
                                                <ReflectionBinding Path="DisplayName" />
                                            </AutoCompleteBox.ValueMemberBinding>
                                            <AutoCompleteBox.ItemTemplate>
                                                <DataTemplate x:DataType="glob:CultureInfo">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </AutoCompleteBox.ItemTemplate>
                                        </AutoCompleteBox>
                                        <Button
                                            x:Name="LocaleChevron"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            Padding="9,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False">
                                            <v:LucideIcon Width="11" Height="11" Symbol="chevron-down" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Text alignment"
                                               IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=text-align-start, x:CompileBindings=False}">
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                            Command="{Binding RestoreClockAlignmentCommand}"
                                            IsVisible="{Binding ClockAlignmentModified}">
                                        <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                    </Button>
                                    <RadioButton
                                        GroupName="ClockAlignment"
                                        Content="Left"
                                        IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Left}}" />
                                    <RadioButton
                                        GroupName="ClockAlignment"
                                        Content="Centered"
                                        IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Center}}" />
                                    <RadioButton
                                        GroupName="ClockAlignment"
                                        Content="Right"
                                        IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Right}}" />
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Display format" Description="Time and date shown by default"
                                               IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=calendar-clock, x:CompileBindings=False}">
                            <ui:FASettingsExpanderItem Content="Time format">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                        <Button Classes="reset" ToolTip.Tip="Restore default" VerticalAlignment="Top"
                                                Command="{Binding RestoreClockTimeFormatCommand}"
                                                IsVisible="{Binding ClockTimeFormatModified}">
                                            <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                        </Button>
                                        <StackPanel Spacing="2" Width="240">
                                            <TextBox Text="{Binding ClockTimeFormat}" PlaceholderText="T" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding TimeSample}" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                Text="{Binding TimeFormatError}"
                                                IsVisible="{Binding TimeFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="Date format">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                        <Button Classes="reset" ToolTip.Tip="Restore default" VerticalAlignment="Top"
                                                Command="{Binding RestoreClockDateFormatCommand}"
                                                IsVisible="{Binding ClockDateFormatModified}">
                                            <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                        </Button>
                                        <StackPanel Spacing="2" Width="240">
                                            <TextBox Text="{Binding ClockDateFormat}" PlaceholderText="D" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding DateSample}" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                Text="{Binding DateFormatError}"
                                                IsVisible="{Binding DateFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander
                            Header="Display format on hover"
                            Description="Time and date shown while hovering the widget"
                            IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=square-mouse-pointer, x:CompileBindings=False}">
                            <ui:FASettingsExpanderItem Content="Time format">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                        <Button Classes="reset" ToolTip.Tip="Restore default" VerticalAlignment="Top"
                                                Command="{Binding RestoreClockTimeFormatHoverCommand}"
                                                IsVisible="{Binding ClockTimeFormatHoverModified}">
                                            <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                        </Button>
                                        <StackPanel Spacing="2" Width="240">
                                            <TextBox Text="{Binding ClockTimeFormatHover}" PlaceholderText="HH:mm:ss" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding TimeHoverSample}" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                Text="{Binding TimeHoverFormatError}"
                                                IsVisible="{Binding TimeHoverFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="Date format">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                        <Button Classes="reset" ToolTip.Tip="Restore default" VerticalAlignment="Top"
                                                Command="{Binding RestoreClockDateFormatHoverCommand}"
                                                IsVisible="{Binding ClockDateFormatHoverModified}">
                                            <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                        </Button>
                                        <StackPanel Spacing="2" Width="240">
                                            <TextBox Text="{Binding ClockDateFormatHover}" PlaceholderText="u" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding DateHoverSample}" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                Text="{Binding DateHoverFormatError}"
                                                IsVisible="{Binding DateHoverFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>

                        <StackPanel Spacing="4" Margin="0,8,0,0">
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="Tokens: HH h mm ss tt dddd ddd MMMM MMM d yyyy zzz" />
                            <HyperlinkButton
                                HorizontalContentAlignment="Left"
                                Padding="0"
                                NavigateUri="https://learn.microsoft.com/dotnet/standard/base-types/custom-date-and-time-format-strings">
                                <TextBlock TextWrapping="Wrap" Text="Reference: Date and time format strings" />
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Metrics page -->
                <ScrollViewer
                    x:Name="MetricsPage"
                    Padding="28,20,28,28"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="False">
                    <StackPanel Spacing="6" MaxWidth="720">
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="Metrics" />
                        <ItemsControl ItemsSource="{Binding MetricGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricGroupViewModel">
                                    <StackPanel Spacing="6" Margin="0,0,0,14">
                                        <TextBlock
                                            Margin="2,4,0,2"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding Header}" />
                                        <ItemsControl ItemsSource="{Binding Toggles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MetricToggleViewModel">
                                                    <ui:FASettingsExpander Margin="0,0,0,6" Header="{Binding Label}">
                                                        <ui:FASettingsExpander.Footer>
                                                            <ToggleSwitch
                                                                IsChecked="{Binding IsVisible}"
                                                                OnContent=""
                                                                OffContent="" />
                                                        </ui:FASettingsExpander.Footer>
                                                    </ui:FASettingsExpander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Updates page -->
                <ScrollViewer
                    x:Name="UpdatesPage"
                    Padding="28,20,28,28"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="False">
                    <StackPanel Spacing="6" MaxWidth="720">
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="Updates" />
                        <ui:FASettingsExpander
                            Header="Check for updates automatically"
                            Description="Look for new releases on a schedule"
                            IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=refresh-cw, x:CompileBindings=False}">
                            <ui:FASettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding UpdateCheckEnabled}" OnContent="" OffContent="" />
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander
                            Header="Frequency"
                            Description="How often to check for new releases"
                            IsEnabled="{Binding UpdateCheckEnabled}"
                            IconSource="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LucideIconSource}, ConverterParameter=timer, x:CompileBindings=False}">
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                            Command="{Binding RestoreUpdateFrequencyCommand}"
                                            IsVisible="{Binding UpdateFrequencyModified}">
                                        <v:LucideIcon Width="20" Height="20" Symbol="rotate-ccw" />
                                    </Button>
                                    <ComboBox
                                        MinWidth="180"
                                        ItemsSource="{Binding UpdateFrequencies}"
                                        SelectedItem="{Binding UpdateFrequency}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:UpdateCheckFrequency">
                                                <TextBlock Text="{Binding Converter={StaticResource FrequencyLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </ui:FANavigationView>
    </Grid>
</Window>
