<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MiniMetrics.ViewModels"
    xmlns:conv="using:MiniMetrics.Converters"
    xmlns:models="using:MiniMetrics.Models"
    xmlns:sys="using:System"
    xmlns:glob="using:System.Globalization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="MiniMetrics.Views.SettingsWindow"
    x:DataType="vm:SettingsViewModel"
    Width="1000"
    Height="720"
    MinWidth="540"
    MinHeight="440"
    Title="Mini Metrics Settings"
    Icon="avares://MiniMetrics/Assets/minimetrics.ico"
    CanResize="True"
    WindowStartupLocation="CenterScreen"
    Background="Transparent"
    TransparencyLevelHint="Mica"
    TransparencyBackgroundFallback="{DynamicResource Chrome.Surface}"
    PointerPressed="OnSettingsPointerPressed">

    <Window.Resources>
        <conv:UpdateFrequencyLabelConverter x:Key="FrequencyLabel" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:StringToFontFamilyConverter x:Key="StringToFontFamily" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TabControl.sidebar > TabItem">
            <Setter Property="MinWidth" Value="190" />
        </Style>
        <Style Selector="TextBlock.description">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Chrome.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Error}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootArea" Focusable="True">
        <TabControl Classes="sidebar" TabStripPlacement="Left">
            <!-- Appearance -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,8,24,24" Spacing="0">

                        <TextBlock Classes="page-title" Text="Appearance" />

                        <TextBlock Classes="section first" Text="Theme and color" />

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Theme" />
                                    <TextBlock Classes="description" Text="Color mode for the app and widgets" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button Classes="reset-link" Content="Reset"
                                            Command="{Binding RestoreThemeCommand}" IsVisible="{Binding ThemeModified}" />
                                    <ComboBox MinWidth="160" ItemsSource="{Binding Themes}"
                                              SelectedItem="{Binding Theme}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Background color" />
                                    <TextBlock Classes="description" Text="Translucent fill behind every widget" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
                                    <ItemsControl ItemsSource="{Binding Swatches}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Right" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <Button
                                                    Width="28"
                                                    Height="28"
                                                    Margin="6,0,0,6"
                                                    Background="{Binding}"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectPresetCommand}"
                                                    CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Classes="reset-link" Content="Reset"
                                                Command="{Binding RestoreBackgroundColorCommand}"
                                                IsVisible="{Binding BackgroundColorModified}" />
                                        <TextBox Width="120" Text="{Binding BackgroundColor}" PlaceholderText="#RRGGBB" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Opacity" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button Classes="reset-link" Content="Reset"
                                            Command="{Binding RestoreOpacityCommand}"
                                            IsVisible="{Binding OpacityModified}" />
                                    <Slider Width="180" Minimum="0" Maximum="100" Value="{Binding Opacity}" />
                                    <NumericUpDown
                                        x:Name="OpacityInput"
                                        Width="84"
                                        VerticalAlignment="Center"
                                        Minimum="0"
                                        Maximum="100"
                                        Increment="1"
                                        Value="{Binding Opacity, Mode=OneWay}"
                                        ShowButtonSpinner="False"
                                        ClipValueToMinMax="True"
                                        KeyDown="OnPercentInputKeyDown"
                                        LostFocus="OnPercentInputLostFocus" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Widget size" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button Classes="reset-link" Content="Reset"
                                            Command="{Binding RestoreWidgetScaleCommand}"
                                            IsVisible="{Binding WidgetScaleModified}" />
                                    <Slider Width="180" Minimum="50" Maximum="200" Value="{Binding WidgetScale}" />
                                    <NumericUpDown
                                        x:Name="WidgetScaleInput"
                                        Width="84"
                                        VerticalAlignment="Center"
                                        Minimum="50"
                                        Maximum="200"
                                        Increment="1"
                                        Value="{Binding WidgetScale, Mode=OneWay}"
                                        ShowButtonSpinner="False"
                                        ClipValueToMinMax="True"
                                        KeyDown="OnPercentInputKeyDown"
                                        LostFocus="OnPercentInputLostFocus" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Classes="section" Text="Typography" />

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Font" />
                                    <TextBlock Classes="description" Text="Typeface used by the widgets" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button Classes="reset-link" Content="Reset"
                                            Command="{Binding RestoreWidgetFontFamilyCommand}"
                                            IsVisible="{Binding WidgetFontFamilyModified}" />
                                    <AutoCompleteBox
                                        x:Name="FontBox"
                                        Width="200"
                                        FontFamily="{Binding WidgetFontFamily, Converter={StaticResource StringToFontFamily}}"
                                        ItemsSource="{Binding AvailableFonts}"
                                        SelectedItem="{Binding WidgetFontFamily}"
                                        FilterMode="Custom"
                                        MinimumPrefixLength="0"
                                        MaxDropDownHeight="280"
                                        PlaceholderText="Search font...">
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <TextBlock
                                                    MaxWidth="188"
                                                    FontFamily="{Binding Converter={StaticResource StringToFontFamily}}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{Binding}" />
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Font weight" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button Classes="reset-link" Content="Reset"
                                            Command="{Binding RestoreWidgetFontWeightCommand}"
                                            IsVisible="{Binding WidgetFontWeightModified}" />
                                    <ComboBox MinWidth="160" ItemsSource="{Binding WidgetFontWeights}"
                                              SelectedItem="{Binding WidgetFontWeight}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Classes="section" Text="Compact layout" />

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="CPU widget" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CpuCompact}" OnContent=""
                                              OffContent="" />
                            </Grid>
                        </Border>
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="GPU widget" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding GpuCompact}" OnContent=""
                                              OffContent="" />
                            </Grid>
                        </Border>
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Clock widget" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DateTimeCompact}" OnContent=""
                                              OffContent="" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Clock -->
            <TabItem Header="Clock">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,8,24,24" Spacing="0">

                        <TextBlock Classes="page-title" Text="Clock" />

                        <TextBlock Classes="section first" Text="Time source" />

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Use local time" />
                                    <TextBlock Classes="description" Text="Follow the system clock and time zone" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseLocalTime}" OnContent=""
                                              OffContent="" />
                            </Grid>
                        </Border>

                        <Border Classes="card" IsEnabled="{Binding !UseLocalTime}">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Time zone" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button Classes="reset-link" Content="Reset"
                                            Command="{Binding RestoreTimeZoneCommand}"
                                            IsVisible="{Binding TimeZoneModified}" />
                                    <AutoCompleteBox
                                        x:Name="TimeZoneBox"
                                        Width="300"
                                        ItemsSource="{Binding TimeZones}"
                                        SelectedItem="{Binding SelectedTimeZone}"
                                        FilterMode="Custom"
                                        MinimumPrefixLength="0"
                                        MaxDropDownHeight="280"
                                        PlaceholderText="Search time zone...">
                                        <AutoCompleteBox.ValueMemberBinding>
                                            <ReflectionBinding Path="DisplayName" />
                                        </AutoCompleteBox.ValueMemberBinding>
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="sys:TimeZoneInfo">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Locale" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button Classes="reset-link" Content="Reset"
                                            Command="{Binding RestoreLocaleCommand}"
                                            IsVisible="{Binding LocaleModified}" />
                                    <AutoCompleteBox
                                        x:Name="LocaleBox"
                                        Width="300"
                                        ItemsSource="{Binding Locales}"
                                        SelectedItem="{Binding SelectedLocale}"
                                        FilterMode="Custom"
                                        MinimumPrefixLength="0"
                                        MaxDropDownHeight="280"
                                        PlaceholderText="Search locale...">
                                        <AutoCompleteBox.ValueMemberBinding>
                                            <ReflectionBinding Path="DisplayName" />
                                        </AutoCompleteBox.ValueMemberBinding>
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="glob:CultureInfo">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Classes="section" Text="Display format" />

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Text alignment" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16"
                                            VerticalAlignment="Center">
                                    <RadioButton GroupName="ClockAlignment" Content="Left"
                                                 IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Left}}" />
                                    <RadioButton GroupName="ClockAlignment" Content="Centered"
                                                 IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Center}}" />
                                    <RadioButton GroupName="ClockAlignment" Content="Right"
                                                 IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Right}}" />
                                    <Button Classes="reset-link" Content="Reset"
                                            Command="{Binding RestoreClockAlignmentCommand}"
                                            IsVisible="{Binding ClockAlignmentModified}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Top">
                                    <TextBlock Text="Time format" />
                                    <TextBlock Classes="description" Text="Shown by default" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Top">
                                    <Button Classes="reset-link" Content="Reset" VerticalAlignment="Top"
                                            Command="{Binding RestoreClockTimeFormatCommand}"
                                            IsVisible="{Binding ClockTimeFormatModified}" />
                                    <StackPanel Spacing="3" Width="240" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding ClockTimeFormat}" PlaceholderText="T" />
                                        <TextBlock Classes="description" Text="{Binding TimeSample}" />
                                        <TextBlock Classes="error" Text="{Binding TimeFormatError}"
                                                   IsVisible="{Binding TimeFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Date format" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Top">
                                    <Button Classes="reset-link" Content="Reset" VerticalAlignment="Top"
                                            Command="{Binding RestoreClockDateFormatCommand}"
                                            IsVisible="{Binding ClockDateFormatModified}" />
                                    <StackPanel Spacing="3" Width="240" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding ClockDateFormat}" PlaceholderText="D" />
                                        <TextBlock Classes="description" Text="{Binding DateSample}" />
                                        <TextBlock Classes="error" Text="{Binding DateFormatError}"
                                                   IsVisible="{Binding DateFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Classes="section" Text="On hover" />

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Top">
                                    <TextBlock Text="Time format" />
                                    <TextBlock Classes="description" Text="Shown while hovering the widget" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Top">
                                    <Button Classes="reset-link" Content="Reset" VerticalAlignment="Top"
                                            Command="{Binding RestoreClockTimeFormatHoverCommand}"
                                            IsVisible="{Binding ClockTimeFormatHoverModified}" />
                                    <StackPanel Spacing="3" Width="240" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding ClockTimeFormatHover}" PlaceholderText="HH:mm:ss" />
                                        <TextBlock Classes="description" Text="{Binding TimeHoverSample}" />
                                        <TextBlock Classes="error" Text="{Binding TimeHoverFormatError}"
                                                   IsVisible="{Binding TimeHoverFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Date format" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Top">
                                    <Button Classes="reset-link" Content="Reset" VerticalAlignment="Top"
                                            Command="{Binding RestoreClockDateFormatHoverCommand}"
                                            IsVisible="{Binding ClockDateFormatHoverModified}" />
                                    <StackPanel Spacing="3" Width="240" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding ClockDateFormatHover}" PlaceholderText="u" />
                                        <TextBlock Classes="description" Text="{Binding DateHoverSample}" />
                                        <TextBlock Classes="error" Text="{Binding DateHoverFormatError}"
                                                   IsVisible="{Binding DateHoverFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Spacing="4" Margin="2,14,2,0">
                            <TextBlock Classes="description" TextWrapping="Wrap"
                                       Text="Tokens: HH h mm ss tt dddd ddd MMMM MMM d yyyy zzz" />
                            <HyperlinkButton
                                HorizontalContentAlignment="Left"
                                Padding="0"
                                NavigateUri="https://learn.microsoft.com/dotnet/standard/base-types/custom-date-and-time-format-strings">
                                <TextBlock TextWrapping="Wrap" Text="Reference: Date and time format strings" />
                            </HyperlinkButton>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Metrics -->
            <TabItem Header="Metrics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,8,24,24" Spacing="0">
                        <TextBlock Classes="page-title" Text="Metrics" />
                        <ItemsControl ItemsSource="{Binding MetricGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricGroupViewModel">
                                    <StackPanel Spacing="0">
                                        <TextBlock Classes="section" Text="{Binding Header}" />
                                        <ItemsControl ItemsSource="{Binding Toggles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MetricToggleViewModel">
                                                    <Border Classes="card">
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                       VerticalAlignment="Center" />
                                                            <ToggleSwitch Grid.Column="1"
                                                                          IsChecked="{Binding IsVisible}" OnContent=""
                                                                          OffContent="" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Updates -->
            <TabItem Header="Updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,8,24,24" Spacing="0">
                        <TextBlock Classes="page-title" Text="Updates" />

                        <TextBlock Classes="section first" Text="Automatic updates" />

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Check for updates automatically" />
                                    <TextBlock Classes="description" Text="Look for new releases on a schedule" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding UpdateCheckEnabled}" OnContent=""
                                              OffContent="" />
                            </Grid>
                        </Border>

                        <Border Classes="card" IsEnabled="{Binding UpdateCheckEnabled}">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Frequency" />
                                    <TextBlock Classes="description" Text="How often to check for new releases" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button Classes="reset-link" Content="Reset"
                                            Command="{Binding RestoreUpdateFrequencyCommand}"
                                            IsVisible="{Binding UpdateFrequencyModified}" />
                                    <ComboBox MinWidth="180" ItemsSource="{Binding UpdateFrequencies}"
                                              SelectedItem="{Binding UpdateFrequency}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:UpdateCheckFrequency">
                                                <TextBlock Text="{Binding Converter={StaticResource FrequencyLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
