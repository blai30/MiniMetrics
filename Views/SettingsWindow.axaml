<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiniMetrics.ViewModels"
        xmlns:conv="using:MiniMetrics.Converters"
        xmlns:models="using:MiniMetrics.Models"
        xmlns:sys="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MiniMetrics.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Mini Metrics Settings"
        Icon="avares://MiniMetrics/Assets/minimetrics.ico"
        Width="520"
        Height="440"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D14"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter">

    <Window.Resources>
        <conv:UpdateFrequencyLabelConverter x:Key="FrequencyLabel" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.section-heading">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#EDEFF2" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#EDEFF2" />
        </Style>

        <!-- Sidebar nav entries: restyle TabItem into a rounded selection pill. -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#9AA1AC" />
            <Setter Property="Width" Value="150" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="14,10">
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#141823" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#EDEFF2" />
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#1A1F2B" />
        </Style>

        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
        </Style>
    </Window.Styles>

    <TabControl TabStripPlacement="Left" Padding="0" Margin="14">

        <TabItem Header="Appearance">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,0,0,0">
                <StackPanel Spacing="18">
                    <TextBlock Classes="section-heading" Text="Appearance" />

                    <StackPanel Spacing="8">
                        <TextBlock Classes="field-label" Text="Background color" />
                        <WrapPanel>
                            <Button Classes="swatch" Background="#0F121D"
                                    Command="{Binding SelectPresetCommand}" CommandParameter="#0F121D" />
                            <Button Classes="swatch" Background="#1A1F2B"
                                    Command="{Binding SelectPresetCommand}" CommandParameter="#1A1F2B" />
                            <Button Classes="swatch" Background="#18181B"
                                    Command="{Binding SelectPresetCommand}" CommandParameter="#18181B" />
                            <Button Classes="swatch" Background="#0C1A2B"
                                    Command="{Binding SelectPresetCommand}" CommandParameter="#0C1A2B" />
                            <Button Classes="swatch" Background="#1E1726"
                                    Command="{Binding SelectPresetCommand}" CommandParameter="#1E1726" />
                            <Button Classes="swatch" Background="#11231C"
                                    Command="{Binding SelectPresetCommand}" CommandParameter="#11231C" />
                        </WrapPanel>
                        <TextBox Text="{Binding BackgroundColor}" PlaceholderText="#RRGGBB" Width="120" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="field-label" Text="Opacity" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Opacity}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Opacity, StringFormat='{}{0:0}%'}"
                                       Width="44"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="#9AA1AC" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Clock">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,0,0,0">
                <StackPanel Spacing="18">
                    <TextBlock Classes="section-heading" Text="Clock" />

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="field-label" Text="Use local time" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseLocalTime}" OnContent="" OffContent="" />
                    </Grid>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="field-label" Text="Time zone" />
                        <ComboBox ItemsSource="{Binding TimeZones}"
                                  SelectedItem="{Binding SelectedTimeZone}"
                                  IsEnabled="{Binding !UseLocalTime}"
                                  HorizontalAlignment="Stretch"
                                  MaxDropDownHeight="280"
                                  ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <ComboBox.Styles>
                                <Style Selector="ComboBox /template/ ScrollViewer">
                                    <Setter Property="(ScrollViewer.AllowAutoHide)" Value="False" />
                                </Style>
                            </ComboBox.Styles>
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="sys:TimeZoneInfo">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Metrics">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,0,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Classes="section-heading" Text="Metrics" />

                    <ItemsControl ItemsSource="{Binding MetricGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MetricGroupViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Header}" FontSize="12" Foreground="#9AA1AC" />
                                    <ItemsControl ItemsSource="{Binding Toggles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MetricToggleViewModel">
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsVisible}" Foreground="#EDEFF2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Updates">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,0,0,0">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-heading" Text="Updates" />
                    <CheckBox Content="Check for updates automatically"
                              IsChecked="{Binding UpdateCheckEnabled}"
                              Foreground="#EDEFF2" />
                    <ComboBox ItemsSource="{Binding UpdateFrequencies}"
                              SelectedItem="{Binding UpdateFrequency}"
                              IsEnabled="{Binding UpdateCheckEnabled}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:UpdateCheckFrequency">
                                <TextBlock Text="{Binding Converter={StaticResource FrequencyLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</Window>
