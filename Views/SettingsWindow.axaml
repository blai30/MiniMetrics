<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiniMetrics.ViewModels"
        xmlns:sys="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MiniMetrics.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Mini Metrics Settings"
        Icon="avares://MiniMetrics/Assets/minimetrics.ico"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D14"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter">

    <StackPanel Margin="20" Spacing="18">

        <StackPanel Spacing="8">
            <TextBlock Text="Background color" FontWeight="SemiBold" Foreground="#EDEFF2" />
            <WrapPanel>
                <WrapPanel.Styles>
                    <Style Selector="Button.swatch">
                        <Setter Property="Width" Value="34" />
                        <Setter Property="Height" Value="34" />
                        <Setter Property="Margin" Value="0,0,8,8" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="#33FFFFFF" />
                    </Style>
                </WrapPanel.Styles>
                <Button Classes="swatch" Background="#0F121D"
                        Command="{Binding SelectPresetCommand}" CommandParameter="#0F121D" />
                <Button Classes="swatch" Background="#1A1F2B"
                        Command="{Binding SelectPresetCommand}" CommandParameter="#1A1F2B" />
                <Button Classes="swatch" Background="#18181B"
                        Command="{Binding SelectPresetCommand}" CommandParameter="#18181B" />
                <Button Classes="swatch" Background="#0C1A2B"
                        Command="{Binding SelectPresetCommand}" CommandParameter="#0C1A2B" />
                <Button Classes="swatch" Background="#1E1726"
                        Command="{Binding SelectPresetCommand}" CommandParameter="#1E1726" />
                <Button Classes="swatch" Background="#11231C"
                        Command="{Binding SelectPresetCommand}" CommandParameter="#11231C" />
            </WrapPanel>
            <TextBox Text="{Binding BackgroundColor}" PlaceholderText="#RRGGBB" Width="120" HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="Opacity" FontWeight="SemiBold" Foreground="#EDEFF2" />
            <Grid ColumnDefinitions="*,Auto">
                <Slider Grid.Column="0" Minimum="0" Maximum="100"
                        Value="{Binding Opacity}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Opacity, StringFormat='{}{0:0}%'}"
                           Width="44"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#9AA1AC" />
            </Grid>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="Time zone" FontWeight="SemiBold" Foreground="#EDEFF2" />
            <ComboBox ItemsSource="{Binding TimeZones}"
                      SelectedItem="{Binding SelectedTimeZone}"
                      HorizontalAlignment="Stretch"
                      MaxDropDownHeight="280"
                      ScrollViewer.VerticalScrollBarVisibility="Visible">
                <ComboBox.Styles>
                    <Style Selector="ComboBox /template/ ScrollViewer">
                        <Setter Property="(ScrollViewer.AllowAutoHide)" Value="False" />
                    </Style>
                </ComboBox.Styles>
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="sys:TimeZoneInfo">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="Metrics" FontWeight="SemiBold" Foreground="#EDEFF2" />

            <ItemsControl ItemsSource="{Binding MetricGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetricGroupViewModel">
                        <StackPanel Spacing="4" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Header}" FontSize="12" Foreground="#9AA1AC" />
                            <ItemsControl ItemsSource="{Binding Toggles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MetricToggleViewModel">
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsVisible}" Foreground="#EDEFF2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

    </StackPanel>
</Window>
