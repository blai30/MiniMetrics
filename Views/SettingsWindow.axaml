<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MiniMetrics.ViewModels"
    xmlns:conv="using:MiniMetrics.Converters"
    xmlns:models="using:MiniMetrics.Models"
    xmlns:sys="using:System"
    xmlns:glob="using:System.Globalization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="MiniMetrics.Views.SettingsWindow"
    x:DataType="vm:SettingsViewModel"
    Width="800"
    Height="720"
    MinWidth="640"
    MinHeight="440"
    Title="Mini Metrics Settings"
    Icon="avares://MiniMetrics/Assets/minimetrics.ico"
    CanResize="True"
    WindowStartupLocation="CenterScreen"
    PointerPressed="OnSettingsPointerPressed">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MiniMetrics/Views/LucideIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:UpdateFrequencyLabelConverter x:Key="FrequencyLabel" />
            <conv:StringToFontFamilyConverter x:Key="StringToFontFamily" />
            <conv:SwatchSelectionThicknessConverter x:Key="SwatchRing" />
            <conv:IndexEqualsConverter x:Key="IndexEquals" />
            <conv:MetricIconConverter x:Key="MetricIcon" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <!-- Pill tabs: a centered horizontal ListBox styled as a shadcn segmented control. -->
        <Style Selector="ListBox.pillTabs">
            <Setter Property="Background" Value="{DynamicResource Settings.Muted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.pillTabs ListBoxItem">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Settings.Text.Secondary}" />
        </Style>
        <Style Selector="ListBox.pillTabs ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource Settings.Text.Primary}" />
        </Style>
        <Style Selector="ListBox.pillTabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Settings.Tab.Active}" />
        </Style>
        <Style Selector="ListBox.pillTabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Settings.Border}" />
        </Style>
        <Style
            Selector="ListBox.pillTabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Settings.Tab.Active}" />
        </Style>

        <!-- Section header: title + muted description + separator. -->
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Settings.Text.Primary}" />
        </Style>
        <Style Selector="TextBlock.sectionDesc">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Settings.Text.Secondary}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Settings.Divider}" />
            <Setter Property="Margin" Value="0,14" />
        </Style>

        <!-- Sub-group heading inside a pane. -->
        <Style Selector="TextBlock.subHeading">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Settings.Text.Primary}" />
            <Setter Property="Margin" Value="0,30,0,6" />
        </Style>

        <!-- Flat row: label/help on the left, control on the right, hairline divider under all but last. -->
        <Style Selector="Grid.row">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="Border.rowFrame">
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.Divider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,12" />
        </Style>
        <Style Selector="StackPanel.rows > Border.rowFrame:nth-last-child(1)">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ItemsControl.metricList ContentPresenter:nth-last-child(1) Border.rowFrame">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBlock.settingLabel">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Settings.Text.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.settingDesc">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Settings.Text.Secondary}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="StackPanel.control">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="24,0,0,0" />
        </Style>
        <Style Selector="Grid.row > StackPanel:nth-child(1)">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- Inline reset link: muted, brightens on hover. -->
        <Style Selector="Button.reset">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Settings.Text.Secondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.reset:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Settings.Text.Primary}" />
        </Style>

        <Style Selector="TextBlock.sample">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Settings.Text.Secondary}" />
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Settings.Error}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Inputs and selects: shadcn sizing; borders/fills come from the zinc Fluent ramp above. -->
        <Style Selector="ScrollViewer ComboBox">
            <Setter Property="Width" Value="180" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ScrollViewer TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ScrollViewer AutoCompleteBox">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ScrollViewer AutoCompleteBox /template/ TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- Searchable dropdown popups: zinc surface (fixed-width items keep the popup from resizing),
             with an always-visible, non-auto-hiding scrollbar (the popup is a separate visual tree, so
             the global ScrollViewer style above does not reach it). -->
        <Style Selector="AutoCompleteBox /template/ ListBox#PART_SelectingItemsControl">
            <Setter Property="Background" Value="{DynamicResource Settings.Card}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
        </Style>

        <!-- Scrollbars are always visible and never auto-hide. -->
        <Style Selector="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>

        <!-- Slider: the Fluent template binds the filled track to Foreground and the unfilled rail to
             Background, so set those on the Slider directly (muted fill, one step above the rail). -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{DynamicResource Settings.Text.Secondary}" />
            <Setter Property="Background" Value="{DynamicResource Settings.Border}" />
        </Style>
        <!-- The slider thumb's inner border uses TemplateBinding Background: keep hover bright and make
             the pressed state a clearly darker shade. -->
        <Style Selector="Slider /template/ Thumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource Settings.Text.Primary}" />
        </Style>
        <Style Selector="Slider /template/ Thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource Settings.Thumb.Pressed}" />
        </Style>

        <!-- Leading row icon size. One place to tune how large every row glyph renders. -->
        <Style Selector="Viewbox.rowIcon">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
        </Style>

        <!-- Leading row icon: stroke-only Lucide glyph, scaled by its Viewbox. Stretch is None so the
             24-unit geometry keeps 1 unit = 1px before the Viewbox scales it; the Margin reserves the
             half-stroke (plus round caps) of headroom that Avalonia's shape stretch does not, so the
             stroke is not clipped on any edge. -->
        <Style Selector="Path.rowIcon">
            <Setter Property="Stroke" Value="{DynamicResource Settings.Text.Primary}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="{x:Null}" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Margin" Value="1.5" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootArea" Focusable="True" RowDefinitions="Auto,*" Background="{DynamicResource Settings.Background}">
        <ListBox x:Name="SectionList" Classes="pillTabs" SelectedIndex="0" Grid.Row="0" Margin="0,16">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBoxItem Content="Appearance" />
            <ListBoxItem Content="Clock" />
            <ListBoxItem Content="Metrics" />
            <ListBoxItem Content="Updates" />
        </ListBox>
        <Grid Grid.Row="1">
            <!-- Appearance -->
            <ScrollViewer
                IsVisible="{Binding #SectionList.SelectedIndex, Converter={StaticResource IndexEquals}, ConverterParameter=0}">
                <StackPanel HorizontalAlignment="Center" Width="560" Margin="0,8,0,24">

                    <TextBlock Classes="sectionTitle" Text="Appearance" />
                    <TextBlock Classes="sectionDesc" Text="Customize how the app and widgets look." />
                    <Border Classes="separator" />

                    <TextBlock Classes="subHeading" Text="Theme &amp; color" Margin="0,2,0,6" />
                    <StackPanel Classes="rows">
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Palette}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Theme" />
                                        <TextBlock Classes="settingDesc" Text="Color mode for the app and widgets" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreThemeCommand}"
                                            IsVisible="{Binding ThemeModified}" />
                                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.PaintBucket}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Background color" />
                                        <TextBlock Classes="settingDesc" Text="Translucent fill behind every widget" />
                                    </StackPanel>
                                </StackPanel>
                                <ItemsControl Grid.Column="1" VerticalAlignment="Center"
                                              ItemsSource="{Binding Swatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <Button Width="28" Height="28" Margin="3" Padding="0"
                                                    CornerRadius="6"
                                                    Background="{Binding}"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectPresetCommand}"
                                                    CommandParameter="{Binding}">
                                                <Border CornerRadius="6"
                                                        BorderBrush="{DynamicResource Settings.Text.Primary}">
                                                    <Border.BorderThickness>
                                                        <MultiBinding Converter="{StaticResource SwatchRing}">
                                                            <Binding />
                                                            <Binding
                                                                Path="$parent[ItemsControl].((vm:SettingsViewModel)DataContext).BackgroundColor" />
                                                        </MultiBinding>
                                                    </Border.BorderThickness>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Hash}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Custom hex" />
                                        <TextBlock Classes="settingDesc" Text="Or enter an exact color" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreBackgroundColorCommand}"
                                            IsVisible="{Binding BackgroundColorModified}" />
                                    <TextBox Width="120" Text="{Binding BackgroundColor}" PlaceholderText="#RRGGBB" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Blend}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Opacity" />
                                        <TextBlock Classes="settingDesc" Text="How opaque the widget background is" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreOpacityCommand}"
                                            IsVisible="{Binding OpacityModified}" />
                                    <Slider Width="130" Minimum="0" Maximum="100" Value="{Binding Opacity}" />
                                    <NumericUpDown
                                        x:Name="OpacityInput"
                                        Width="92"
                                        Height="34"
                                        VerticalAlignment="Center"
                                        Minimum="0"
                                        Maximum="100"
                                        Increment="1"
                                        Value="{Binding Opacity, Mode=OneWay}"
                                        ShowButtonSpinner="False"
                                        ClipValueToMinMax="True"
                                        KeyDown="OnPercentInputKeyDown"
                                        LostFocus="OnPercentInputLostFocus" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Classes="subHeading" Text="Widgets" />
                    <StackPanel Classes="rows">
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Cpu}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="CPU widget size" />
                                        <TextBlock Classes="settingDesc" Text="Scale of the CPU widget" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreCpuScaleCommand}"
                                            IsVisible="{Binding CpuScaleModified}" />
                                    <Slider Width="130" Minimum="50" Maximum="200" Value="{Binding CpuScale}" />
                                    <NumericUpDown
                                        x:Name="CpuScaleInput"
                                        Width="92"
                                        Height="34"
                                        VerticalAlignment="Center"
                                        Minimum="50"
                                        Maximum="200"
                                        Increment="1"
                                        Value="{Binding CpuScale, Mode=OneWay}"
                                        ShowButtonSpinner="False"
                                        ClipValueToMinMax="True"
                                        KeyDown="OnPercentInputKeyDown"
                                        LostFocus="OnPercentInputLostFocus" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Gpu}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="GPU widget size" />
                                        <TextBlock Classes="settingDesc" Text="Scale of the GPU widget" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreGpuScaleCommand}"
                                            IsVisible="{Binding GpuScaleModified}" />
                                    <Slider Width="130" Minimum="50" Maximum="200" Value="{Binding GpuScale}" />
                                    <NumericUpDown
                                        x:Name="GpuScaleInput"
                                        Width="92"
                                        Height="34"
                                        VerticalAlignment="Center"
                                        Minimum="50"
                                        Maximum="200"
                                        Increment="1"
                                        Value="{Binding GpuScale, Mode=OneWay}"
                                        ShowButtonSpinner="False"
                                        ClipValueToMinMax="True"
                                        KeyDown="OnPercentInputKeyDown"
                                        LostFocus="OnPercentInputLostFocus" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Clock}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Clock widget size" />
                                        <TextBlock Classes="settingDesc" Text="Scale of the clock widget" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreClockScaleCommand}"
                                            IsVisible="{Binding ClockScaleModified}" />
                                    <Slider Width="130" Minimum="50" Maximum="200" Value="{Binding ClockScale}" />
                                    <NumericUpDown
                                        x:Name="ClockScaleInput"
                                        Width="92"
                                        Height="34"
                                        VerticalAlignment="Center"
                                        Minimum="50"
                                        Maximum="200"
                                        Increment="1"
                                        Value="{Binding ClockScale, Mode=OneWay}"
                                        ShowButtonSpinner="False"
                                        ClipValueToMinMax="True"
                                        KeyDown="OnPercentInputKeyDown"
                                        LostFocus="OnPercentInputLostFocus" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Type}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Font" />
                                        <TextBlock Classes="settingDesc" Text="Typeface used by the widgets" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreWidgetFontFamilyCommand}"
                                            IsVisible="{Binding WidgetFontFamilyModified}" />
                                    <AutoCompleteBox
                                        x:Name="FontBox"
                                        Width="240"
                                        FontFamily="{Binding WidgetFontFamily, Converter={StaticResource StringToFontFamily}}"
                                        ItemsSource="{Binding AvailableFonts}"
                                        SelectedItem="{Binding WidgetFontFamily}"
                                        FilterMode="Custom"
                                        MinimumPrefixLength="0"
                                        MaxDropDownHeight="280"
                                        PlaceholderText="Search font...">
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <TextBlock
                                                    Width="210"
                                                    FontFamily="{Binding Converter={StaticResource StringToFontFamily}}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{Binding}" />
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Bold}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Font weight" />
                                        <TextBlock Classes="settingDesc" Text="Weight used by the widgets" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreWidgetFontWeightCommand}"
                                            IsVisible="{Binding WidgetFontWeightModified}" />
                                    <ComboBox ItemsSource="{Binding WidgetFontWeights}"
                                              SelectedItem="{Binding WidgetFontWeight}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Classes="subHeading" Text="Compact layout" />
                    <StackPanel Classes="rows">
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Cpu}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="CPU widget" />
                                        <TextBlock Classes="settingDesc" Text="Condensed single-line layout" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                              IsChecked="{Binding CpuCompact}" OnContent="" OffContent="" />
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Gpu}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="GPU widget" />
                                        <TextBlock Classes="settingDesc" Text="Condensed single-line layout" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                              IsChecked="{Binding GpuCompact}" OnContent="" OffContent="" />
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Clock}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Clock widget" />
                                        <TextBlock Classes="settingDesc" Text="Condensed single-line layout" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                              IsChecked="{Binding DateTimeCompact}" OnContent="" OffContent="" />
                            </Grid>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Clock -->
            <ScrollViewer
                IsVisible="{Binding #SectionList.SelectedIndex, Converter={StaticResource IndexEquals}, ConverterParameter=1}">
                <StackPanel HorizontalAlignment="Center" Width="560" Margin="0,8,0,24">

                    <TextBlock Classes="sectionTitle" Text="Clock" />
                    <TextBlock Classes="sectionDesc" Text="Time zone, locale, and how the clock widget reads." />
                    <Border Classes="separator" />

                    <TextBlock Classes="subHeading" Text="Time zone &amp; locale" Margin="0,2,0,6" />
                    <StackPanel Classes="rows">
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.MapPin}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Use local time" />
                                        <TextBlock Classes="settingDesc" Text="Follow the system clock and time zone" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                              IsChecked="{Binding UseLocalTime}" OnContent="" OffContent="" />
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Globe}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Time zone" />
                                        <TextBlock Classes="settingDesc" Text="Used when local time is off" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset" IsEnabled="{Binding !UseLocalTime}"
                                            Command="{Binding RestoreTimeZoneCommand}"
                                            IsVisible="{Binding TimeZoneModified}" />
                                    <AutoCompleteBox
                                        x:Name="TimeZoneBox"
                                        Width="240"
                                        IsEnabled="{Binding !UseLocalTime}"
                                        ItemsSource="{Binding TimeZones}"
                                        SelectedItem="{Binding SelectedTimeZone}"
                                        FilterMode="Custom"
                                        MinimumPrefixLength="0"
                                        MaxDropDownHeight="280"
                                        PlaceholderText="Search time zone...">
                                        <AutoCompleteBox.ValueMemberBinding>
                                            <ReflectionBinding Path="DisplayName" />
                                        </AutoCompleteBox.ValueMemberBinding>
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="sys:TimeZoneInfo">
                                                <TextBlock Width="210" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Languages}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Locale" />
                                        <TextBlock Classes="settingDesc" Text="Language for names and formats" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreLocaleCommand}"
                                            IsVisible="{Binding LocaleModified}" />
                                    <AutoCompleteBox
                                        x:Name="LocaleBox"
                                        Width="240"
                                        ItemsSource="{Binding Locales}"
                                        SelectedItem="{Binding SelectedLocale}"
                                        FilterMode="Custom"
                                        MinimumPrefixLength="0"
                                        MaxDropDownHeight="280"
                                        PlaceholderText="Search locale...">
                                        <AutoCompleteBox.ValueMemberBinding>
                                            <ReflectionBinding Path="DisplayName" />
                                        </AutoCompleteBox.ValueMemberBinding>
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="glob:CultureInfo">
                                                <TextBlock Width="210" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Classes="subHeading" Text="Display format" />
                    <StackPanel Classes="rows">
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.AlignLeft}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Alignment" />
                                        <TextBlock Classes="settingDesc" Text="How the widget text is aligned" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreClockAlignmentCommand}"
                                            IsVisible="{Binding ClockAlignmentModified}" />
                                    <ListBox Classes="pillTabs" HorizontalAlignment="Right"
                                             ItemsSource="{Binding ClockAlignments}"
                                             SelectedItem="{Binding ClockAlignment}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Clock}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Time" />
                                        <TextBlock Classes="settingDesc" Text="Default time format" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreClockTimeFormatCommand}"
                                            IsVisible="{Binding ClockTimeFormatModified}" />
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBox Width="150" Text="{Binding ClockTimeFormat}" PlaceholderText="T" />
                                        <TextBlock Classes="sample" Text="{Binding TimeSample}" />
                                        <TextBlock Classes="error" Text="{Binding TimeFormatError}"
                                                   IsVisible="{Binding TimeFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Calendar}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Date" />
                                        <TextBlock Classes="settingDesc" Text="Default date format" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreClockDateFormatCommand}"
                                            IsVisible="{Binding ClockDateFormatModified}" />
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBox Width="150" Text="{Binding ClockDateFormat}" PlaceholderText="D" />
                                        <TextBlock Classes="sample" Text="{Binding DateSample}" />
                                        <TextBlock Classes="error" Text="{Binding DateFormatError}"
                                                   IsVisible="{Binding DateFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Classes="subHeading" Text="On hover" />
                    <StackPanel Classes="rows">
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Clock}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Time" />
                                        <TextBlock Classes="settingDesc" Text="Shown while hovering the widget" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreClockTimeFormatHoverCommand}"
                                            IsVisible="{Binding ClockTimeFormatHoverModified}" />
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBox Width="150" Text="{Binding ClockTimeFormatHover}"
                                                 PlaceholderText="HH:mm:ss" />
                                        <TextBlock Classes="sample" Text="{Binding TimeHoverSample}" />
                                        <TextBlock Classes="error" Text="{Binding TimeHoverFormatError}"
                                                   IsVisible="{Binding TimeHoverFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.Calendar}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Date" />
                                        <TextBlock Classes="settingDesc" Text="Shown while hovering the widget" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            Command="{Binding RestoreClockDateFormatHoverCommand}"
                                            IsVisible="{Binding ClockDateFormatHoverModified}" />
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBox Width="150" Text="{Binding ClockDateFormatHover}"
                                                 PlaceholderText="u" />
                                        <TextBlock Classes="sample" Text="{Binding DateHoverSample}" />
                                        <TextBlock Classes="error" Text="{Binding DateHoverFormatError}"
                                                   IsVisible="{Binding DateHoverFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Classes="settingDesc" TextWrapping="Wrap"
                                   Text="Tokens: HH h mm ss tt dddd ddd MMMM MMM d yyyy zzz" />
                        <HyperlinkButton Padding="0" Margin="0,6,0,0"
                                         NavigateUri="https://learn.microsoft.com/dotnet/standard/base-types/custom-date-and-time-format-strings">
                            <TextBlock Classes="settingDesc" Foreground="{DynamicResource Settings.Text.Primary}"
                                       Text="Reference: date and time format strings" />
                        </HyperlinkButton>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Metrics -->
            <ScrollViewer
                IsVisible="{Binding #SectionList.SelectedIndex, Converter={StaticResource IndexEquals}, ConverterParameter=2}">
                <StackPanel HorizontalAlignment="Center" Width="560" Margin="0,8,0,24">
                    <TextBlock Classes="sectionTitle" Text="Metrics" />
                    <TextBlock Classes="sectionDesc" Text="Choose which readings each widget shows." />
                    <Border Classes="separator" />
                    <ItemsControl ItemsSource="{Binding MetricGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MetricGroupViewModel">
                                <StackPanel>
                                    <TextBlock Classes="subHeading" Text="{Binding Header}" />
                                    <ItemsControl Classes="metricList" ItemsSource="{Binding Toggles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MetricToggleViewModel">
                                                <Border Classes="rowFrame">
                                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    Spacing="12">
                                                            <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                                                <Path Classes="rowIcon"
                                                                      Data="{Binding Key, Converter={StaticResource MetricIcon}}" />
                                                            </Viewbox>
                                                            <StackPanel>
                                                                <TextBlock Classes="settingLabel"
                                                                           Text="{Binding Label}" />
                                                                <TextBlock Classes="settingDesc"
                                                                           Text="Requires elevation and the PawnIO driver"
                                                                           IsVisible="{Binding RequiresElevation}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                                      IsChecked="{Binding IsVisible}"
                                                                      OnContent="" OffContent="" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Updates -->
            <ScrollViewer
                IsVisible="{Binding #SectionList.SelectedIndex, Converter={StaticResource IndexEquals}, ConverterParameter=3}">
                <StackPanel HorizontalAlignment="Center" Width="560" Margin="0,8,0,24">
                    <TextBlock Classes="sectionTitle" Text="Updates" />
                    <TextBlock Classes="sectionDesc" Text="How the app checks for new releases." />
                    <Border Classes="separator" />
                    <StackPanel Classes="rows">
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.RefreshCw}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Check for updates automatically" />
                                        <TextBlock Classes="settingDesc" Text="Look for new releases on a schedule" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                              IsChecked="{Binding UpdateCheckEnabled}" OnContent="" OffContent="" />
                            </Grid>
                        </Border>
                        <Border Classes="rowFrame">
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Classes="rowIcon" VerticalAlignment="Center">
                                        <Path Classes="rowIcon" Data="{StaticResource Lucide.CalendarClock}" />
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Classes="settingLabel" Text="Frequency" />
                                        <TextBlock Classes="settingDesc" Text="How often to check for new releases" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="control">
                                    <Button Classes="reset" Content="Reset"
                                            IsEnabled="{Binding UpdateCheckEnabled}"
                                            Command="{Binding RestoreUpdateFrequencyCommand}"
                                            IsVisible="{Binding UpdateFrequencyModified}" />
                                    <ComboBox IsEnabled="{Binding UpdateCheckEnabled}"
                                              ItemsSource="{Binding UpdateFrequencies}"
                                              SelectedItem="{Binding UpdateFrequency}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:UpdateCheckFrequency">
                                                <TextBlock
                                                    Text="{Binding Converter={StaticResource FrequencyLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
