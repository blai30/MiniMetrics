<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:MiniMetrics.ViewModels"
    xmlns:conv="using:MiniMetrics.Converters"
    xmlns:models="using:MiniMetrics.Models"
    xmlns:sys="using:System"
    xmlns:glob="using:System.Globalization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="MiniMetrics.Views.SettingsWindow"
    x:DataType="vm:SettingsViewModel"
    Width="940"
    Height="680"
    MinWidth="540"
    MinHeight="440"
    FontSize="16"
    TransparencyLevelHint="Mica"
    Background="Transparent"
    Title="Mini Metrics Settings"
    Icon="avares://MiniMetrics/Assets/minimetrics.ico"
    CanResize="True"
    WindowStartupLocation="CenterScreen"
    PointerPressed="OnSettingsPointerPressed">

    <Window.Resources>
        <conv:UpdateFrequencyLabelConverter x:Key="FrequencyLabel" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:StringToFontFamilyConverter x:Key="StringToFontFamily" />
        <StreamGeometry x:Key="UndoIcon">M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <!-- A non-expandable setting card (no items) still toggles IsExpanded when its empty space is
        clicked; FluentAvalonia resets it, but in between the expanded content border is laid out and the
        card grows ~1px. Zeroing that border on :empty cards makes the stray click have no layout effect. -->
        <Style Selector="ui|FASettingsExpander:empty /template/ Expander#Expander">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- The per-option restore-default button. Transparent, borderless, and only visible while the
        option strays from its default (each instance binds IsVisible to that option's *Modified flag). -->
        <Style Selector="Button.reset">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootArea" Focusable="True">
        <ui:FANavigationView
            x:Name="Nav"
            PaneDisplayMode="Left"
            IsSettingsVisible="False"
            IsBackButtonVisible="False"
            OpenPaneLength="200"
            SelectionChanged="OnNavSelectionChanged">
            <ui:FANavigationView.MenuItems>
                <ui:FANavigationViewItem Content="Appearance" Tag="Appearance" IsSelected="True">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Setting" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="Clock" Tag="Clock">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Clock" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="Metrics" Tag="Metrics">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Home" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="Updates" Tag="Updates">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Refresh" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
            </ui:FANavigationView.MenuItems>

            <ui:FANavigationView.PaneFooter>
                <HyperlinkButton
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Margin="4,0,4,4"
                    Padding="12,8"
                    NavigateUri="https://github.com/blai30/MiniMetrics"
                    ToolTip.Tip="View MiniMetrics on GitHub">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon
                            Width="16"
                            Height="16"
                            Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                        <TextBlock VerticalAlignment="Center" Text="GitHub" />
                    </StackPanel>
                </HyperlinkButton>
            </ui:FANavigationView.PaneFooter>

            <Grid>
                <!-- Appearance page -->
                <ScrollViewer x:Name="AppearancePage" Padding="28,20,28,28" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6" MaxWidth="720">
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="Appearance" />

                        <ui:FASettingsExpander Header="Theme" Description="Color mode for the app and widgets">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Setting" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                        Command="{Binding RestoreThemeCommand}" IsVisible="{Binding ThemeModified}">
                                        <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                    </Button>
                                    <ComboBox
                                        MinWidth="160"
                                        ItemsSource="{Binding Themes}"
                                        SelectedItem="{Binding Theme}" />
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander
                            Header="Background color"
                            Description="Translucent fill behind every widget">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Edit" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpanderItem>
                                <ItemsControl ItemsSource="{Binding Swatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <Button
                                                Width="34"
                                                Height="34"
                                                Margin="0,0,8,8"
                                                CornerRadius="8"
                                                Background="{Binding}"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectPresetCommand}"
                                                CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="Custom hex">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="reset" ToolTip.Tip="Restore default"
                                            Command="{Binding RestoreBackgroundColorCommand}" IsVisible="{Binding BackgroundColorModified}">
                                            <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                        </Button>
                                        <TextBox
                                            Width="120"
                                            Text="{Binding BackgroundColor}"
                                            PlaceholderText="#RRGGBB" />
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Opacity" Description="How opaque the widget background is">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Highlight" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                        Command="{Binding RestoreOpacityCommand}" IsVisible="{Binding OpacityModified}">
                                        <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                    </Button>
                                    <Grid ColumnDefinitions="200,Auto">
                                        <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Opacity}" />
                                        <NumericUpDown
                                            Grid.Column="1"
                                            x:Name="OpacityInput"
                                            Width="96"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            TextAlignment="Right"
                                            Minimum="0"
                                            Maximum="100"
                                            Increment="1"
                                            Value="{Binding Opacity, Mode=OneWay}"
                                            ShowButtonSpinner="False"
                                            ClipValueToMinMax="True"
                                            KeyDown="OnPercentInputKeyDown"
                                            LostFocus="OnPercentInputLostFocus">
                                            <NumericUpDown.InnerRightContent>
                                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="%" />
                                            </NumericUpDown.InnerRightContent>
                                        </NumericUpDown>
                                    </Grid>
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Widget size" Description="Scale of every widget on screen">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="FullScreen" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                        Command="{Binding RestoreWidgetScaleCommand}" IsVisible="{Binding WidgetScaleModified}">
                                        <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                    </Button>
                                    <Grid ColumnDefinitions="200,Auto">
                                        <Slider Grid.Column="0" Minimum="50" Maximum="200" Value="{Binding WidgetScale}" />
                                        <NumericUpDown
                                            Grid.Column="1"
                                            x:Name="WidgetScaleInput"
                                            Width="96"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            TextAlignment="Right"
                                            Minimum="50"
                                            Maximum="200"
                                            Increment="1"
                                            Value="{Binding WidgetScale, Mode=OneWay}"
                                            ShowButtonSpinner="False"
                                            ClipValueToMinMax="True"
                                            KeyDown="OnPercentInputKeyDown"
                                            LostFocus="OnPercentInputLostFocus">
                                            <NumericUpDown.InnerRightContent>
                                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="%" />
                                            </NumericUpDown.InnerRightContent>
                                        </NumericUpDown>
                                    </Grid>
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Font" Description="Typeface and weight used by the widgets">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Font" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                        Command="{Binding RestoreWidgetFontFamilyCommand}" IsVisible="{Binding WidgetFontFamilyModified}">
                                        <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                    </Button>
                                    <Grid Width="200">
                                        <AutoCompleteBox
                                            x:Name="FontBox"
                                            HorizontalAlignment="Stretch"
                                            FontFamily="{Binding WidgetFontFamily, Converter={StaticResource StringToFontFamily}}"
                                            ItemsSource="{Binding AvailableFonts}"
                                            SelectedItem="{Binding WidgetFontFamily}"
                                            FilterMode="Custom"
                                            MinimumPrefixLength="0"
                                            MaxDropDownHeight="280"
                                            PlaceholderText="Search font...">
                                            <AutoCompleteBox.ItemTemplate>
                                                <!-- Each name is drawn in the font it names. TextTrimming keeps a
                                                long name from widening the fixed-width dropdown popup. -->
                                                <DataTemplate x:DataType="sys:String">
                                                    <TextBlock
                                                        MaxWidth="168"
                                                        FontFamily="{Binding Converter={StaticResource StringToFontFamily}}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Text="{Binding}" />
                                                </DataTemplate>
                                            </AutoCompleteBox.ItemTemplate>
                                        </AutoCompleteBox>
                                        <Button
                                            x:Name="FontChevron"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            Padding="9,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False">
                                            <PathIcon Width="11" Height="11" Data="M0,0 L4,4 L8,0 Z" />
                                        </Button>
                                    </Grid>
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                        Command="{Binding RestoreWidgetFontWeightCommand}" IsVisible="{Binding WidgetFontWeightModified}">
                                        <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                    </Button>
                                    <ComboBox
                                        MinWidth="140"
                                        ItemsSource="{Binding WidgetFontWeights}"
                                        SelectedItem="{Binding WidgetFontWeight}" />
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander
                            Header="Compact layout"
                            Description="Use the condensed single-line widget layout">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="List" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpanderItem Content="CPU widget">
                                <ui:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch IsChecked="{Binding CpuCompact}" OnContent="" OffContent="" />
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="GPU widget">
                                <ui:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch IsChecked="{Binding GpuCompact}" OnContent="" OffContent="" />
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="Clock widget">
                                <ui:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch IsChecked="{Binding DateTimeCompact}" OnContent="" OffContent="" />
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Clock page -->
                <ScrollViewer
                    x:Name="ClockPage"
                    Padding="28,20,28,28"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="False">
                    <StackPanel Spacing="6" MaxWidth="720">
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="Clock" />

                        <ui:FASettingsExpander
                            Header="Use local time"
                            Description="Follow the system clock and time zone">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Clock" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding UseLocalTime}" OnContent="" OffContent="" />
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <!-- Globe not in confirmed-valid FASymbol list; substituted with Calendar -->
                        <ui:FASettingsExpander Header="Time zone" IsEnabled="{Binding !UseLocalTime}">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Calendar" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                        Command="{Binding RestoreTimeZoneCommand}" IsVisible="{Binding TimeZoneModified}">
                                        <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                    </Button>
                                    <Grid Width="340">
                                        <AutoCompleteBox
                                            x:Name="TimeZoneBox"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding TimeZones}"
                                            SelectedItem="{Binding SelectedTimeZone}"
                                            FilterMode="Custom"
                                            MinimumPrefixLength="0"
                                            MaxDropDownHeight="280"
                                            PlaceholderText="Search time zone...">
                                            <AutoCompleteBox.ValueMemberBinding>
                                                <ReflectionBinding Path="DisplayName" />
                                            </AutoCompleteBox.ValueMemberBinding>
                                            <AutoCompleteBox.ItemTemplate>
                                                <DataTemplate x:DataType="sys:TimeZoneInfo">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </AutoCompleteBox.ItemTemplate>
                                        </AutoCompleteBox>
                                        <Button
                                            x:Name="TimeZoneChevron"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            Padding="9,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False">
                                            <PathIcon Width="11" Height="11" Data="M0,0 L4,4 L8,0 Z" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <!-- Globe not in confirmed-valid FASymbol list; substituted with Calendar -->
                        <ui:FASettingsExpander Header="Locale">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Calendar" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                        Command="{Binding RestoreLocaleCommand}" IsVisible="{Binding LocaleModified}">
                                        <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                    </Button>
                                    <Grid Width="340">
                                        <AutoCompleteBox
                                            x:Name="LocaleBox"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding Locales}"
                                            SelectedItem="{Binding SelectedLocale}"
                                            FilterMode="Custom"
                                            MinimumPrefixLength="0"
                                            MaxDropDownHeight="280"
                                            PlaceholderText="Search locale...">
                                            <AutoCompleteBox.ValueMemberBinding>
                                                <ReflectionBinding Path="DisplayName" />
                                            </AutoCompleteBox.ValueMemberBinding>
                                            <AutoCompleteBox.ItemTemplate>
                                                <DataTemplate x:DataType="glob:CultureInfo">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </AutoCompleteBox.ItemTemplate>
                                        </AutoCompleteBox>
                                        <Button
                                            x:Name="LocaleChevron"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            Padding="9,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False">
                                            <PathIcon Width="11" Height="11" Data="M0,0 L4,4 L8,0 Z" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <!-- AlignLeft not in confirmed-valid FASymbol list; substituted with List -->
                        <ui:FASettingsExpander Header="Text alignment">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="List" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                        Command="{Binding RestoreClockAlignmentCommand}" IsVisible="{Binding ClockAlignmentModified}">
                                        <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                    </Button>
                                    <RadioButton
                                        GroupName="ClockAlignment"
                                        Content="Left"
                                        IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Left}}" />
                                    <RadioButton
                                        GroupName="ClockAlignment"
                                        Content="Centered"
                                        IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Center}}" />
                                    <RadioButton
                                        GroupName="ClockAlignment"
                                        Content="Right"
                                        IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Right}}" />
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Display format" Description="Time and date shown by default">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Calendar" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpanderItem Content="Time format">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                        <Button Classes="reset" ToolTip.Tip="Restore default" VerticalAlignment="Top"
                                            Command="{Binding RestoreClockTimeFormatCommand}" IsVisible="{Binding ClockTimeFormatModified}">
                                            <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                        </Button>
                                        <StackPanel Spacing="2" Width="240">
                                            <TextBox Text="{Binding ClockTimeFormat}" PlaceholderText="T" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding TimeSample}" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                Text="{Binding TimeFormatError}"
                                                IsVisible="{Binding TimeFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="Date format">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                        <Button Classes="reset" ToolTip.Tip="Restore default" VerticalAlignment="Top"
                                            Command="{Binding RestoreClockDateFormatCommand}" IsVisible="{Binding ClockDateFormatModified}">
                                            <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                        </Button>
                                        <StackPanel Spacing="2" Width="240">
                                            <TextBox Text="{Binding ClockDateFormat}" PlaceholderText="D" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding DateSample}" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                Text="{Binding DateFormatError}"
                                                IsVisible="{Binding DateFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander
                            Header="Display format on hover"
                            Description="Time and date shown while hovering the widget">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Calendar" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpanderItem Content="Time format">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                        <Button Classes="reset" ToolTip.Tip="Restore default" VerticalAlignment="Top"
                                            Command="{Binding RestoreClockTimeFormatHoverCommand}" IsVisible="{Binding ClockTimeFormatHoverModified}">
                                            <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                        </Button>
                                        <StackPanel Spacing="2" Width="240">
                                            <TextBox Text="{Binding ClockTimeFormatHover}" PlaceholderText="HH:mm:ss" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding TimeHoverSample}" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                Text="{Binding TimeHoverFormatError}"
                                                IsVisible="{Binding TimeHoverFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="Date format">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                        <Button Classes="reset" ToolTip.Tip="Restore default" VerticalAlignment="Top"
                                            Command="{Binding RestoreClockDateFormatHoverCommand}" IsVisible="{Binding ClockDateFormatHoverModified}">
                                            <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                        </Button>
                                        <StackPanel Spacing="2" Width="240">
                                            <TextBox Text="{Binding ClockDateFormatHover}" PlaceholderText="u" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding DateHoverSample}" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                Text="{Binding DateHoverFormatError}"
                                                IsVisible="{Binding DateHoverFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>

                        <StackPanel Spacing="4" Margin="0,8,0,0">
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="Tokens: HH h mm ss tt dddd ddd MMMM MMM d yyyy zzz" />
                            <HyperlinkButton
                                HorizontalContentAlignment="Left"
                                Padding="0"
                                NavigateUri="https://learn.microsoft.com/dotnet/standard/base-types/custom-date-and-time-format-strings">
                                <TextBlock TextWrapping="Wrap" Text="Reference: Date and time format strings" />
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Metrics page -->
                <ScrollViewer
                    x:Name="MetricsPage"
                    Padding="28,20,28,28"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="False">
                    <StackPanel Spacing="6" MaxWidth="720">
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="Metrics" />
                        <ItemsControl ItemsSource="{Binding MetricGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricGroupViewModel">
                                    <StackPanel Spacing="6" Margin="0,0,0,14">
                                        <TextBlock
                                            Margin="2,4,0,2"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding Header}" />
                                        <ItemsControl ItemsSource="{Binding Toggles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MetricToggleViewModel">
                                                    <ui:FASettingsExpander Margin="0,0,0,6" Header="{Binding Label}">
                                                        <ui:FASettingsExpander.Footer>
                                                            <ToggleSwitch
                                                                IsChecked="{Binding IsVisible}"
                                                                OnContent=""
                                                                OffContent="" />
                                                        </ui:FASettingsExpander.Footer>
                                                    </ui:FASettingsExpander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Updates page -->
                <ScrollViewer
                    x:Name="UpdatesPage"
                    Padding="28,20,28,28"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="False">
                    <StackPanel Spacing="6" MaxWidth="720">
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="Updates" />
                        <ui:FASettingsExpander
                            Header="Check for updates automatically"
                            Description="Look for new releases on a schedule">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Refresh" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding UpdateCheckEnabled}" OnContent="" OffContent="" />
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander
                            Header="Frequency"
                            Description="How often to check for new releases"
                            IsEnabled="{Binding UpdateCheckEnabled}">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Clock" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="reset" ToolTip.Tip="Restore default"
                                        Command="{Binding RestoreUpdateFrequencyCommand}" IsVisible="{Binding UpdateFrequencyModified}">
                                        <PathIcon Width="13" Height="13" Data="{StaticResource UndoIcon}" />
                                    </Button>
                                    <ComboBox
                                        MinWidth="180"
                                        ItemsSource="{Binding UpdateFrequencies}"
                                        SelectedItem="{Binding UpdateFrequency}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:UpdateCheckFrequency">
                                                <TextBlock Text="{Binding Converter={StaticResource FrequencyLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </ui:FANavigationView>
    </Grid>
</Window>
