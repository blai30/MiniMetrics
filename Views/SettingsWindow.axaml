<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="using:MiniMetrics.ViewModels"
        xmlns:conv="using:MiniMetrics.Converters"
        xmlns:models="using:MiniMetrics.Models"
        xmlns:sys="using:System"
        xmlns:glob="using:System.Globalization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MiniMetrics.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Mini Metrics Settings"
        Icon="avares://MiniMetrics/Assets/minimetrics.ico"
        Width="940"
        Height="680"
        CanResize="True"
        MinWidth="540"
        MinHeight="440"
        FontSize="16"
        TransparencyLevelHint="Mica"
        Background="Transparent"
        PointerPressed="OnSettingsPointerPressed"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:UpdateFrequencyLabelConverter x:Key="FrequencyLabel" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
    </Window.Resources>

    <Grid x:Name="RootArea" Focusable="True">
        <ui:FANavigationView x:Name="Nav"
                             PaneDisplayMode="Left"
                             IsSettingsVisible="False"
                             IsBackButtonVisible="False"
                             OpenPaneLength="200"
                             SelectionChanged="OnNavSelectionChanged">
            <ui:FANavigationView.MenuItems>
                <ui:FANavigationViewItem Content="Appearance" Tag="Appearance" IsSelected="True">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Setting" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="Clock" Tag="Clock">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Clock" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="Metrics" Tag="Metrics">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Home" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="Updates" Tag="Updates">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Refresh" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
            </ui:FANavigationView.MenuItems>

            <Grid>
                <!-- Appearance page -->
                <ScrollViewer x:Name="AppearancePage" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                    <StackPanel Spacing="6" MaxWidth="720">
                        <TextBlock Text="Appearance" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <ui:FASettingsExpander Header="Theme" Description="Color mode for the app and widgets">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Setting" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="160" />
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Background color" Description="Translucent fill behind every widget">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Edit" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpanderItem>
                                <ItemsControl ItemsSource="{Binding Swatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <Button Width="34" Height="34" Margin="0,0,8,8" CornerRadius="8"
                                                    Background="{Binding}"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectPresetCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="Custom hex">
                                <ui:FASettingsExpanderItem.Footer>
                                    <TextBox Text="{Binding BackgroundColor}" PlaceholderText="#RRGGBB" Width="120" />
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Opacity" Description="How opaque the widget background is">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Highlight" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <Grid ColumnDefinitions="200,Auto">
                                    <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Opacity}" />
                                    <NumericUpDown Grid.Column="1" x:Name="OpacityInput"
                                                   Minimum="0" Maximum="100" Increment="1"
                                                   Value="{Binding Opacity, Mode=OneWay}"
                                                   ShowButtonSpinner="False" ClipValueToMinMax="True"
                                                   TextAlignment="Right" Width="96" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   KeyDown="OnPercentInputKeyDown" LostFocus="OnPercentInputLostFocus">
                                        <NumericUpDown.InnerRightContent>
                                            <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        </NumericUpDown.InnerRightContent>
                                    </NumericUpDown>
                                </Grid>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Widget size" Description="Scale of every widget on screen">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="FullScreen" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <Grid ColumnDefinitions="200,Auto">
                                    <Slider Grid.Column="0" Minimum="50" Maximum="200" Value="{Binding WidgetScale}" />
                                    <NumericUpDown Grid.Column="1" x:Name="WidgetScaleInput"
                                                   Minimum="50" Maximum="200" Increment="1"
                                                   Value="{Binding WidgetScale, Mode=OneWay}"
                                                   ShowButtonSpinner="False" ClipValueToMinMax="True"
                                                   TextAlignment="Right" Width="96" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   KeyDown="OnPercentInputKeyDown" LostFocus="OnPercentInputLostFocus">
                                        <NumericUpDown.InnerRightContent>
                                            <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        </NumericUpDown.InnerRightContent>
                                    </NumericUpDown>
                                </Grid>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Font" Description="Typeface and weight used by the widgets">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Font" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding WidgetFontFamily}" MinWidth="160">
                                        <ComboBox.Styles>
                                            <Style Selector="ComboBox /template/ ScrollViewer">
                                                <Setter Property="(ScrollViewer.AllowAutoHide)" Value="False" />
                                            </Style>
                                        </ComboBox.Styles>
                                    </ComboBox>
                                    <ComboBox ItemsSource="{Binding WidgetFontWeights}" SelectedItem="{Binding WidgetFontWeight}" MinWidth="140" />
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Compact layout" Description="Use the condensed single-line widget layout">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="List" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpanderItem Content="CPU widget">
                                <ui:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch IsChecked="{Binding CpuCompact}" OnContent="" OffContent="" />
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="GPU widget">
                                <ui:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch IsChecked="{Binding GpuCompact}" OnContent="" OffContent="" />
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="Clock widget">
                                <ui:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch IsChecked="{Binding DateTimeCompact}" OnContent="" OffContent="" />
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Clock page -->
                <ScrollViewer x:Name="ClockPage" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28" IsVisible="False">
                    <StackPanel Spacing="6" MaxWidth="720">
                        <TextBlock Text="Clock" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <ui:FASettingsExpander Header="Use local time" Description="Follow the system clock and time zone">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Clock" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding UseLocalTime}" OnContent="" OffContent="" />
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <!-- Globe not in confirmed-valid FASymbol list; substituted with Calendar -->
                        <ui:FASettingsExpander Header="Time zone" IsEnabled="{Binding !UseLocalTime}">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Calendar" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <Grid Width="340">
                                    <AutoCompleteBox x:Name="TimeZoneBox"
                                                     ItemsSource="{Binding TimeZones}"
                                                     SelectedItem="{Binding SelectedTimeZone}"
                                                     FilterMode="Custom" MinimumPrefixLength="0" MaxDropDownHeight="280"
                                                     HorizontalAlignment="Stretch" PlaceholderText="Search time zone...">
                                        <AutoCompleteBox.ValueMemberBinding>
                                            <ReflectionBinding Path="DisplayName" />
                                        </AutoCompleteBox.ValueMemberBinding>
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="sys:TimeZoneInfo">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                    <Button x:Name="TimeZoneChevron" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                            Background="Transparent" BorderThickness="0" Padding="9,0" Focusable="False">
                                        <PathIcon Width="11" Height="11" Data="M0,0 L4,4 L8,0 Z" />
                                    </Button>
                                </Grid>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <!-- Globe not in confirmed-valid FASymbol list; substituted with Calendar -->
                        <ui:FASettingsExpander Header="Locale">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Calendar" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <Grid Width="340">
                                    <AutoCompleteBox x:Name="LocaleBox"
                                                     ItemsSource="{Binding Locales}"
                                                     SelectedItem="{Binding SelectedLocale}"
                                                     FilterMode="Custom" MinimumPrefixLength="0" MaxDropDownHeight="280"
                                                     HorizontalAlignment="Stretch" PlaceholderText="Search locale...">
                                        <AutoCompleteBox.ValueMemberBinding>
                                            <ReflectionBinding Path="DisplayName" />
                                        </AutoCompleteBox.ValueMemberBinding>
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="glob:CultureInfo">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                    <Button x:Name="LocaleChevron" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                            Background="Transparent" BorderThickness="0" Padding="9,0" Focusable="False">
                                        <PathIcon Width="11" Height="11" Data="M0,0 L4,4 L8,0 Z" />
                                    </Button>
                                </Grid>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <!-- AlignLeft not in confirmed-valid FASymbol list; substituted with List -->
                        <ui:FASettingsExpander Header="Text alignment">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="List" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <RadioButton Content="Left" GroupName="ClockAlignment"
                                                 IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Left}}" />
                                    <RadioButton Content="Centered" GroupName="ClockAlignment"
                                                 IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Center}}" />
                                    <RadioButton Content="Right" GroupName="ClockAlignment"
                                                 IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Right}}" />
                                </StackPanel>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Display format" Description="Time and date shown by default">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Calendar" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpanderItem Content="Time format">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Spacing="2" Width="240">
                                        <TextBox Text="{Binding ClockTimeFormat}" PlaceholderText="T" />
                                        <TextBlock Text="{Binding TimeSample}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding TimeFormatError}" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   IsVisible="{Binding TimeFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="Date format">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Spacing="2" Width="240">
                                        <TextBox Text="{Binding ClockDateFormat}" PlaceholderText="D" />
                                        <TextBlock Text="{Binding DateSample}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding DateFormatError}" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   IsVisible="{Binding DateFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Display format on hover" Description="Time and date shown while hovering the widget">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Calendar" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpanderItem Content="Time format">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Spacing="2" Width="240">
                                        <TextBox Text="{Binding ClockTimeFormatHover}" PlaceholderText="HH:mm:ss" />
                                        <TextBlock Text="{Binding TimeHoverSample}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding TimeHoverFormatError}" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   IsVisible="{Binding TimeHoverFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                            <ui:FASettingsExpanderItem Content="Date format">
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Spacing="2" Width="240">
                                        <TextBox Text="{Binding ClockDateFormatHover}" PlaceholderText="u" />
                                        <TextBlock Text="{Binding DateHoverSample}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding DateHoverFormatError}" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   IsVisible="{Binding DateHoverFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </ui:FASettingsExpander>

                        <StackPanel Spacing="4" Margin="0,8,0,0">
                            <TextBlock Text="Tokens: HH h mm ss tt dddd ddd MMMM MMM d yyyy zzz"
                                       FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <HyperlinkButton NavigateUri="https://learn.microsoft.com/dotnet/standard/base-types/custom-date-and-time-format-strings"
                                             HorizontalContentAlignment="Left" Padding="0">
                                <TextBlock Text="Reference: Date and time format strings" TextWrapping="Wrap" />
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Metrics page -->
                <ScrollViewer x:Name="MetricsPage" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28" IsVisible="False">
                    <StackPanel Spacing="6" MaxWidth="720">
                        <TextBlock Text="Metrics" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding MetricGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricGroupViewModel">
                                    <StackPanel Spacing="6" Margin="0,0,0,14">
                                        <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" Margin="2,4,0,2" />
                                        <ItemsControl ItemsSource="{Binding Toggles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MetricToggleViewModel">
                                                    <ui:FASettingsExpander Header="{Binding Label}" Margin="0,0,0,6">
                                                        <ui:FASettingsExpander.Footer>
                                                            <ToggleSwitch IsChecked="{Binding IsVisible}" OnContent="" OffContent="" />
                                                        </ui:FASettingsExpander.Footer>
                                                    </ui:FASettingsExpander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Updates page -->
                <ScrollViewer x:Name="UpdatesPage" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28" IsVisible="False">
                    <StackPanel Spacing="6" MaxWidth="720">
                        <TextBlock Text="Updates" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ui:FASettingsExpander Header="Check for updates automatically" Description="Look for new releases on a schedule">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Refresh" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding UpdateCheckEnabled}" OnContent="" OffContent="" />
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>

                        <ui:FASettingsExpander Header="Frequency" Description="How often to check for new releases"
                                               IsEnabled="{Binding UpdateCheckEnabled}">
                            <ui:FASettingsExpander.IconSource>
                                <ui:FASymbolIconSource Symbol="Clock" />
                            </ui:FASettingsExpander.IconSource>
                            <ui:FASettingsExpander.Footer>
                                <ComboBox ItemsSource="{Binding UpdateFrequencies}" SelectedItem="{Binding UpdateFrequency}" MinWidth="180">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:UpdateCheckFrequency">
                                            <TextBlock Text="{Binding Converter={StaticResource FrequencyLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </ui:FASettingsExpander.Footer>
                        </ui:FASettingsExpander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </ui:FANavigationView>
    </Grid>
</Window>
