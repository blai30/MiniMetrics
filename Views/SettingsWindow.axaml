<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MiniMetrics.ViewModels"
    xmlns:conv="using:MiniMetrics.Converters"
    xmlns:models="using:MiniMetrics.Models"
    xmlns:sys="using:System"
    xmlns:glob="using:System.Globalization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="MiniMetrics.Views.SettingsWindow"
    x:DataType="vm:SettingsViewModel"
    Width="1000"
    Height="720"
    MinWidth="540"
    MinHeight="440"
    Title="Mini Metrics Settings"
    Icon="avares://MiniMetrics/Assets/minimetrics.ico"
    CanResize="True"
    WindowStartupLocation="CenterScreen"
    PointerPressed="OnSettingsPointerPressed">

    <Window.Resources>
        <conv:UpdateFrequencyLabelConverter x:Key="FrequencyLabel" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:StringToFontFamilyConverter x:Key="StringToFontFamily" />
    </Window.Resources>

    <Grid x:Name="RootArea" Focusable="True">
        <TabControl>
            <!-- Appearance -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Theme" />
                            <TextBlock Text="Color mode for the app and widgets" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox MinWidth="160" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                                <Button Content="Reset" Command="{Binding RestoreThemeCommand}" IsVisible="{Binding ThemeModified}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Background color" />
                            <TextBlock Text="Translucent fill behind every widget" />
                            <ItemsControl ItemsSource="{Binding Swatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sys:String">
                                        <Button
                                            Width="34"
                                            Height="34"
                                            Margin="0,0,8,8"
                                            Background="{Binding}"
                                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectPresetCommand}"
                                            CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Custom hex" VerticalAlignment="Center" />
                                <TextBox Width="120" Text="{Binding BackgroundColor}" PlaceholderText="#RRGGBB" />
                                <Button Content="Reset" Command="{Binding RestoreBackgroundColorCommand}" IsVisible="{Binding BackgroundColorModified}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Opacity" />
                            <TextBlock Text="How opaque the widget background is" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Slider Width="200" Minimum="0" Maximum="100" Value="{Binding Opacity}" />
                                <NumericUpDown
                                    x:Name="OpacityInput"
                                    Width="96"
                                    VerticalAlignment="Center"
                                    Minimum="0"
                                    Maximum="100"
                                    Increment="1"
                                    Value="{Binding Opacity, Mode=OneWay}"
                                    ShowButtonSpinner="False"
                                    ClipValueToMinMax="True"
                                    KeyDown="OnPercentInputKeyDown"
                                    LostFocus="OnPercentInputLostFocus" />
                                <Button Content="Reset" Command="{Binding RestoreOpacityCommand}" IsVisible="{Binding OpacityModified}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Widget size" />
                            <TextBlock Text="Scale of every widget on screen" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Slider Width="200" Minimum="50" Maximum="200" Value="{Binding WidgetScale}" />
                                <NumericUpDown
                                    x:Name="WidgetScaleInput"
                                    Width="96"
                                    VerticalAlignment="Center"
                                    Minimum="50"
                                    Maximum="200"
                                    Increment="1"
                                    Value="{Binding WidgetScale, Mode=OneWay}"
                                    ShowButtonSpinner="False"
                                    ClipValueToMinMax="True"
                                    KeyDown="OnPercentInputKeyDown"
                                    LostFocus="OnPercentInputLostFocus" />
                                <Button Content="Reset" Command="{Binding RestoreWidgetScaleCommand}" IsVisible="{Binding WidgetScaleModified}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Font" />
                            <TextBlock Text="Typeface and weight used by the widgets" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <AutoCompleteBox
                                    x:Name="FontBox"
                                    Width="200"
                                    FontFamily="{Binding WidgetFontFamily, Converter={StaticResource StringToFontFamily}}"
                                    ItemsSource="{Binding AvailableFonts}"
                                    SelectedItem="{Binding WidgetFontFamily}"
                                    FilterMode="Custom"
                                    MinimumPrefixLength="0"
                                    MaxDropDownHeight="280"
                                    PlaceholderText="Search font...">
                                    <AutoCompleteBox.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <TextBlock
                                                MaxWidth="168"
                                                FontFamily="{Binding Converter={StaticResource StringToFontFamily}}"
                                                TextTrimming="CharacterEllipsis"
                                                Text="{Binding}" />
                                        </DataTemplate>
                                    </AutoCompleteBox.ItemTemplate>
                                </AutoCompleteBox>
                                <Button Content="Reset" Command="{Binding RestoreWidgetFontFamilyCommand}" IsVisible="{Binding WidgetFontFamilyModified}" />
                                <ComboBox MinWidth="140" ItemsSource="{Binding WidgetFontWeights}" SelectedItem="{Binding WidgetFontWeight}" />
                                <Button Content="Reset" Command="{Binding RestoreWidgetFontWeightCommand}" IsVisible="{Binding WidgetFontWeightModified}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Compact layout" />
                            <TextBlock Text="Use the condensed single-line widget layout" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="CPU widget" VerticalAlignment="Center" />
                                <ToggleSwitch IsChecked="{Binding CpuCompact}" OnContent="" OffContent="" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="GPU widget" VerticalAlignment="Center" />
                                <ToggleSwitch IsChecked="{Binding GpuCompact}" OnContent="" OffContent="" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Clock widget" VerticalAlignment="Center" />
                                <ToggleSwitch IsChecked="{Binding DateTimeCompact}" OnContent="" OffContent="" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Clock -->
            <TabItem Header="Clock">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Use local time" />
                            <TextBlock Text="Follow the system clock and time zone" />
                            <ToggleSwitch IsChecked="{Binding UseLocalTime}" OnContent="" OffContent="" />
                        </StackPanel>

                        <StackPanel Spacing="4" IsEnabled="{Binding !UseLocalTime}">
                            <TextBlock Text="Time zone" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <AutoCompleteBox
                                    x:Name="TimeZoneBox"
                                    Width="340"
                                    ItemsSource="{Binding TimeZones}"
                                    SelectedItem="{Binding SelectedTimeZone}"
                                    FilterMode="Custom"
                                    MinimumPrefixLength="0"
                                    MaxDropDownHeight="280"
                                    PlaceholderText="Search time zone...">
                                    <AutoCompleteBox.ValueMemberBinding>
                                        <ReflectionBinding Path="DisplayName" />
                                    </AutoCompleteBox.ValueMemberBinding>
                                    <AutoCompleteBox.ItemTemplate>
                                        <DataTemplate x:DataType="sys:TimeZoneInfo">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </AutoCompleteBox.ItemTemplate>
                                </AutoCompleteBox>
                                <Button Content="Reset" Command="{Binding RestoreTimeZoneCommand}" IsVisible="{Binding TimeZoneModified}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Locale" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <AutoCompleteBox
                                    x:Name="LocaleBox"
                                    Width="340"
                                    ItemsSource="{Binding Locales}"
                                    SelectedItem="{Binding SelectedLocale}"
                                    FilterMode="Custom"
                                    MinimumPrefixLength="0"
                                    MaxDropDownHeight="280"
                                    PlaceholderText="Search locale...">
                                    <AutoCompleteBox.ValueMemberBinding>
                                        <ReflectionBinding Path="DisplayName" />
                                    </AutoCompleteBox.ValueMemberBinding>
                                    <AutoCompleteBox.ItemTemplate>
                                        <DataTemplate x:DataType="glob:CultureInfo">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </AutoCompleteBox.ItemTemplate>
                                </AutoCompleteBox>
                                <Button Content="Reset" Command="{Binding RestoreLocaleCommand}" IsVisible="{Binding LocaleModified}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Text alignment" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton GroupName="ClockAlignment" Content="Left"
                                    IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Left}}" />
                                <RadioButton GroupName="ClockAlignment" Content="Centered"
                                    IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Center}}" />
                                <RadioButton GroupName="ClockAlignment" Content="Right"
                                    IsChecked="{Binding ClockAlignment, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ClockAlignment.Right}}" />
                                <Button Content="Reset" Command="{Binding RestoreClockAlignmentCommand}" IsVisible="{Binding ClockAlignmentModified}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Display format" />
                            <TextBlock Text="Time and date shown by default" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Time format" Width="90" VerticalAlignment="Top" />
                                <StackPanel Spacing="2" Width="240">
                                    <TextBox Text="{Binding ClockTimeFormat}" PlaceholderText="T" />
                                    <TextBlock Text="{Binding TimeSample}" />
                                    <TextBlock Text="{Binding TimeFormatError}"
                                               IsVisible="{Binding TimeFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <Button Content="Reset" VerticalAlignment="Top" Command="{Binding RestoreClockTimeFormatCommand}" IsVisible="{Binding ClockTimeFormatModified}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Date format" Width="90" VerticalAlignment="Top" />
                                <StackPanel Spacing="2" Width="240">
                                    <TextBox Text="{Binding ClockDateFormat}" PlaceholderText="D" />
                                    <TextBlock Text="{Binding DateSample}" />
                                    <TextBlock Text="{Binding DateFormatError}"
                                               IsVisible="{Binding DateFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <Button Content="Reset" VerticalAlignment="Top" Command="{Binding RestoreClockDateFormatCommand}" IsVisible="{Binding ClockDateFormatModified}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Display format on hover" />
                            <TextBlock Text="Time and date shown while hovering the widget" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Time format" Width="90" VerticalAlignment="Top" />
                                <StackPanel Spacing="2" Width="240">
                                    <TextBox Text="{Binding ClockTimeFormatHover}" PlaceholderText="HH:mm:ss" />
                                    <TextBlock Text="{Binding TimeHoverSample}" />
                                    <TextBlock Text="{Binding TimeHoverFormatError}"
                                               IsVisible="{Binding TimeHoverFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <Button Content="Reset" VerticalAlignment="Top" Command="{Binding RestoreClockTimeFormatHoverCommand}" IsVisible="{Binding ClockTimeFormatHoverModified}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Date format" Width="90" VerticalAlignment="Top" />
                                <StackPanel Spacing="2" Width="240">
                                    <TextBox Text="{Binding ClockDateFormatHover}" PlaceholderText="u" />
                                    <TextBlock Text="{Binding DateHoverSample}" />
                                    <TextBlock Text="{Binding DateHoverFormatError}"
                                               IsVisible="{Binding DateHoverFormatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <Button Content="Reset" VerticalAlignment="Top" Command="{Binding RestoreClockDateFormatHoverCommand}" IsVisible="{Binding ClockDateFormatHoverModified}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock TextWrapping="Wrap" Text="Tokens: HH h mm ss tt dddd ddd MMMM MMM d yyyy zzz" />
                            <HyperlinkButton
                                HorizontalContentAlignment="Left"
                                Padding="0"
                                NavigateUri="https://learn.microsoft.com/dotnet/standard/base-types/custom-date-and-time-format-strings">
                                <TextBlock TextWrapping="Wrap" Text="Reference: Date and time format strings" />
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Metrics -->
            <TabItem Header="Metrics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" Spacing="16">
                        <ItemsControl ItemsSource="{Binding MetricGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricGroupViewModel">
                                    <StackPanel Spacing="4" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Header}" />
                                        <ItemsControl ItemsSource="{Binding Toggles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MetricToggleViewModel">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                        <ToggleSwitch IsChecked="{Binding IsVisible}" OnContent="" OffContent="" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Updates -->
            <TabItem Header="Updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Check for updates automatically" />
                            <TextBlock Text="Look for new releases on a schedule" />
                            <ToggleSwitch IsChecked="{Binding UpdateCheckEnabled}" OnContent="" OffContent="" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsEnabled="{Binding UpdateCheckEnabled}">
                            <TextBlock Text="Frequency" />
                            <TextBlock Text="How often to check for new releases" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox MinWidth="180" ItemsSource="{Binding UpdateFrequencies}" SelectedItem="{Binding UpdateFrequency}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:UpdateCheckFrequency">
                                            <TextBlock Text="{Binding Converter={StaticResource FrequencyLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Reset" Command="{Binding RestoreUpdateFrequencyCommand}" IsVisible="{Binding UpdateFrequencyModified}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
