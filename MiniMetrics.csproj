<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <!-- Dev default; the release pipeline overrides this with -p:Version from the git tag. A 0.0.0
        local build reads as an unreleased dev build rather than a misleading 1.0.0. -->
        <VersionPrefix>0.0.0</VersionPrefix>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets\minimetrics.ico</ApplicationIcon>
        <!-- The test project is nested under the repo root, so exclude it from this project's default file globbing. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);MiniMetrics.Tests\**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <!-- Only the tray icon is loaded at runtime; the other Assets files are design sources. -->
        <AvaloniaResource Include="Assets\minimetrics.ico" />
    </ItemGroup>

    <ItemGroup>
        <!-- Workstation GC sizes gen0 from the largest CPU cache (48 MB on a 96 MB-L3 X3D part), so a widget
        that allocates a few KB per tick commits tens of MB of garbage between collections. Undocumented
        but honored; re-check GC.GetConfigurationVariables()["GCGen0MaxBudget"] after .NET upgrades. -->
        <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="4194304" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
        <PackageReference Include="Velopack" Version="1.2.161" />
    </ItemGroup>
</Project>
