<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Chrome.TextStrong" Color="#1B1F27" />
                    <SolidColorBrush x:Key="Chrome.TextMuted" Color="#5F6571" />
                    <SolidColorBrush x:Key="Chrome.TextSubtle" Color="#8A909C" />
                    <SolidColorBrush x:Key="Chrome.Surface" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="Chrome.CardBg" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="Chrome.CardBorder" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="Chrome.NavFill" Color="#0E000000" />
                    <SolidColorBrush x:Key="Chrome.Error" Color="#C42B1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Chrome.TextStrong" Color="#F0F1F4" />
                    <SolidColorBrush x:Key="Chrome.TextMuted" Color="#9BA1AC" />
                    <SolidColorBrush x:Key="Chrome.TextSubtle" Color="#878D99" />
                    <SolidColorBrush x:Key="Chrome.Surface" Color="#202225" />
                    <SolidColorBrush x:Key="Chrome.CardBg" Color="#2C2C30" />
                    <SolidColorBrush x:Key="Chrome.CardBorder" Color="#3A3A40" />
                    <SolidColorBrush x:Key="Chrome.NavFill" Color="#16FFFFFF" />
                    <SolidColorBrush x:Key="Chrome.Error" Color="#FF99A4" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Accent built from the canonical system accent color, which populates from
                 the Windows accent. Used where the Fluent AccentFillColor* brushes do not
                 resolve on this build (reset link, nav accent bar). -->
            <SolidColorBrush x:Key="Chrome.Accent" Color="{DynamicResource SystemAccentColor}" />
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Page title at the top of each tab (Windows type ramp: Title, 28). -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Chrome.TextStrong}" />
        <Setter Property="Margin" Value="0,4,0,14" />
    </Style>

    <!-- Section heading above a group of cards (Windows type ramp: Body Strong, 14 semibold). -->
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Chrome.TextStrong}" />
        <Setter Property="Margin" Value="2,18,2,8" />
    </Style>
    <Style Selector="TextBlock.section.first">
        <Setter Property="Margin" Value="2,2,2,8" />
    </Style>

    <!-- Setting card: the Fluent content layer. One setting per card, sitting on Mica. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Chrome.CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Quiet accent text link that stands in for a per-row Reset button. -->
    <Style Selector="Button.reset-link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Chrome.Accent}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.reset-link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.reset-link:pointerover">
        <Setter Property="Opacity" Value="0.75" />
    </Style>

    <!-- Sidebar nav: TabControl with the strip on the left, sitting on Mica. -->
    <Style Selector="TabControl.sidebar">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabControl.sidebar > TabItem">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="Foreground" Value="{DynamicResource Chrome.TextMuted}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_LayoutRoot"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <Border Name="AccentBar"
                                Width="3" Height="16" CornerRadius="2"
                                HorizontalAlignment="Left"
                                IsVisible="False"
                                Background="{DynamicResource Chrome.Accent}" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.sidebar > TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource Chrome.NavFill}" />
    </Style>
    <Style Selector="TabControl.sidebar > TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource Chrome.NavFill}" />
    </Style>
    <Style Selector="TabControl.sidebar > TabItem:selected /template/ Border#AccentBar">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="TabControl.sidebar > TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource Chrome.TextStrong}" />
    </Style>
</Styles>
